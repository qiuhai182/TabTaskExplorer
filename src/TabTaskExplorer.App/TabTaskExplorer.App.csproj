<Project Sdk="Microsoft.NET.Sdk">

  <!-- 应用层工程：界面只引用内核；平台工程仅在组合根处被使用 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TabTaskExplorer.App</RootNamespace>
    <AssemblyName>TabTaskExplorer</AssemblyName>
    <!-- Avalonia 12 默认开启编译期绑定，模板内缺少 x:DataType 时改用反射绑定，与既有代码保持一致 -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 应用清单：声明 supportedOS，NativeControlHost（视频渲染面）创建原生子窗口时必需 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <EmbeddedResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\TabX\*.png" />
    <AvaloniaResource Include="Assets\TabX-Dark\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabTaskExplorer.Kernel\TabTaskExplorer.Kernel.csproj" />
    <ProjectReference Include="..\TabTaskExplorer.Protocol.Ssh\TabTaskExplorer.Protocol.Ssh.csproj" />
    <ProjectReference Include="..\TabTaskExplorer.Protocol.Ftp\TabTaskExplorer.Protocol.Ftp.csproj" />
    <ProjectReference Include="..\TabTaskExplorer.Platform.Windows\TabTaskExplorer.Platform.Windows.csproj" />
    <ProjectReference Include="..\TabTaskExplorer.Platform.Linux\TabTaskExplorer.Platform.Linux.csproj" />
    <ProjectReference Include="..\TabTaskExplorer.Platform.MacOS\TabTaskExplorer.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <!-- 音视频解码后端：Windows 随包分发 libvlc（约 110MB，build.bat 会做 plugins 裁剪）；
       Linux / macOS 不随包分发，运行时使用系统安装的 libvlc -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!-- 品牌图标：由 tools/generate-app-icon.ps1 生成多尺寸 app.ico 与窗口徽标；
       脚本自带增量保护（图标已比脚本新时直接跳过），Windows 构建失败也不阻断编译 -->
  <Target Name="GenerateBrandIcons" BeforeTargets="BeforeBuild"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\generate-app-icon.ps1&quot;"
          ContinueOnError="true" StandardOutputImportance="Low" />
  </Target>

  <!-- libvlc 包默认把 x64 / x86 / arm64 三套原生库全部拷出（合计约 300MB），
       这里只保留与目标架构匹配的一套，构建产物从 300MB 降到约 100MB -->
  <Target Name="TrimLibVlcArchitectures" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <RemoveDir Directories="$(OutDir)libvlc\win-x86" Condition="'$(RuntimeIdentifier)' != 'win-x86'" />
    <RemoveDir Directories="$(OutDir)libvlc\win-arm64" Condition="'$(RuntimeIdentifier)' != 'win-arm64'" />
    <RemoveDir Directories="$(OutDir)libvlc\win-x64" Condition="'$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-arm64'" />
  </Target>

</Project>
