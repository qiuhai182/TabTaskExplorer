<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:TabTaskExplorer.App.Services"
        x:Class="TabTaskExplorer.App.Views.DiskViewPanel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

    <!-- 行 0：路径栏与操作按钮 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
      <TextBox Grid.Column="0" Text="{Binding RootPathInput}" Watermark="输入磁盘或目录路径，点击扫描统计占用" />
      <Button Grid.Column="1" Content="打开" Margin="6,0,0,0" Click="OnOpenClick" />
      <Button Grid.Column="2" Content="上一级" Margin="6,0,0,0" Click="OnNavigateUpClick" />
      <Button Grid.Column="3" Content="刷新" Margin="6,0,0,0" Click="OnRefreshClick" />
    </Grid>

    <!-- 行 1：统计摘要 -->
    <TextBlock Grid.Row="1" Margin="0,8,0,8" Text="{Binding SummaryText}" />

    <!-- 行 2：表头与占用列表 -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <!-- 表头：名称与大小两个星号列设上限，窗口过宽时右侧留白；拖动列边界调整列宽 -->
      <Grid Grid.Row="0" Margin="0,0,0,4"
            svc:ColumnResize.Enabled="True"
            svc:ColumnResize.Widths="{Binding ColumnWidths}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.6*" MaxWidth="440" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="1.7*" MaxWidth="260" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Tag="Name" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="名称" />
            <TextBlock x:Name="ArrowName" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Tag="Type" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="类型" />
            <TextBlock x:Name="ArrowType" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Tag="Size" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="大小" />
            <TextBlock x:Name="ArrowSize" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Tag="Free" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="剩余" />
            <TextBlock x:Name="ArrowFree" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Tag="Usage" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="使用率" />
            <TextBlock x:Name="ArrowUsage" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
        <Button Grid.Column="5" Tag="FileSystem" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="文件系统" />
            <TextBlock x:Name="ArrowFileSystem" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Tapped="OnRowTapped">
        <ListBox.ContextMenu>
          <ContextMenu Opening="OnBackgroundMenuOpening">
            <MenuItem Header="刷新" Click="OnBackgroundRefreshClick" />
            <MenuItem Header="新建文件夹…" Click="OnBackgroundNewFolderClick" />
            <MenuItem Header="新建文件…" Click="OnBackgroundNewFileClick" />
            <MenuItem Header="粘贴" Click="OnBackgroundPasteClick" />
            <Separator />
            <MenuItem Header="返回上一级" Click="OnBackgroundNavigateUpClick" />
            <MenuItem Header="系统右键菜单（全部）" IsVisible="False" Tag="DiskSystemMenuHost" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="Transparent">
              <Border.ContextMenu>
                <ContextMenu Opening="OnSystemMenuOpening">
                  <MenuItem Header="打开" Click="OnMenuOpenClick" />
                  <MenuItem Header="在新标签打开" Click="OnMenuOpenInNewTabClick" />
                  <Separator />
                  <MenuItem Header="复制" Click="OnMenuCopyClick" />
                  <MenuItem Header="剪切" Click="OnMenuCutClick" />
                  <MenuItem Header="复制路径" Click="OnMenuCopyPathClick" />
                  <MenuItem Header="粘贴到该文件夹" Click="OnMenuPasteToRowClick" />
                  <Separator />
                  <MenuItem Header="重命名" Click="OnMenuRenameClick" />
                  <MenuItem Header="删除到回收站" Click="OnMenuDeleteClick" />
                  <MenuItem Header="永久删除…" Click="OnMenuDeletePermanentlyClick" />
                  <Separator />
                  <MenuItem Header="在资源管理器打开" Click="OnMenuOpenInExplorerClick" />
                  <MenuItem Header="系统右键菜单（全部）" IsVisible="False" Tag="DiskSystemMenuHost" />
                </ContextMenu>
              </Border.ContextMenu>
              <!-- 列定义与表头一致：星号列设上限，列宽拖动结果经附加属性同步到所有行 -->
              <Grid svc:ColumnResize.Widths="{Binding DataContext.ColumnWidths, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.6*" MaxWidth="440" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="1.7*" MaxWidth="260" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="{Binding IndentMargin}" ColumnDefinitions="16,*">
                  <TextBlock Grid.Column="0" Text="{Binding ExpandGlyph}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding EntryTypeText}" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" />
                <TextBlock Grid.Column="3" Text="{Binding FreeText}" />
                <TextBlock Grid.Column="4" Text="{Binding UsageText}" />
                <TextBlock Grid.Column="5" Text="{Binding FileSystemText}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

  </Grid>
</UserControl>
