<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TabTaskExplorer.App.Views.TaskBoardPanel">

  <Grid RowDefinitions="Auto,*" Margin="8">

    <!-- 新建任务 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBox x:Name="NewTaskBox" Width="320" Watermark="输入任务标题，回车或点击添加" KeyDown="OnNewTaskKeyDown" />
      <Button Content="添加任务" Click="OnAddClick" />
    </StackPanel>

    <!-- 三列看板 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,8,*,8,*">
      <Border Grid.Column="0" Padding="8" BorderBrush="#40808080" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="待办" FontWeight="Medium" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding TodoItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8" Margin="0,4" BorderBrush="#30808080" BorderThickness="1" CornerRadius="6">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="Medium" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                      <Button Content="?" Click="OnMoveForwardClick" ToolTip.Tip="开始进行" />
                      <Button Content="?" Click="OnDeleteClick" ToolTip.Tip="删除任务" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Padding="8" BorderBrush="#40808080" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="进行中" FontWeight="Medium" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding InProgressItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8" Margin="0,4" BorderBrush="#30808080" BorderThickness="1" CornerRadius="6">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="Medium" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                      <Button Content="?" Click="OnMoveBackClick" ToolTip.Tip="退回待办" />
                      <Button Content="?" Click="OnMoveForwardClick" ToolTip.Tip="标记完成" />
                      <Button Content="?" Click="OnDeleteClick" ToolTip.Tip="删除任务" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Column="4" Padding="8" BorderBrush="#40808080" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="已完成" FontWeight="Medium" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding DoneItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8" Margin="0,4" BorderBrush="#30808080" BorderThickness="1" CornerRadius="6" Opacity="0.75">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="Medium" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                      <Button Content="?" Click="OnMoveBackClick" ToolTip.Tip="重新打开" />
                      <Button Content="?" Click="OnDeleteClick" ToolTip.Tip="删除任务" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
