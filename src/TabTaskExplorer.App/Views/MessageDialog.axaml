<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TabTaskExplorer.App.Views.MessageDialog"
        Width="380" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <TextBox x:Name="PasswordInput" IsVisible="False" PasswordChar="*" Watermark="请输入密码" />
    <CheckBox x:Name="ApplyAllCheck" Content="本批统一按此处理" IsVisible="False" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="OkButton" Content="确定" Click="OnOkClick" MinWidth="80" />
      <Button x:Name="SaveButton" Content="保存" Click="OnSaveChoiceClick" MinWidth="80" IsVisible="False" />
      <Button x:Name="DontSaveButton" Content="不保存" Click="OnDontSaveChoiceClick" MinWidth="80" IsVisible="False" />
      <Button x:Name="CancelChoiceButton" Content="取消" Click="OnCancelChoiceClick" MinWidth="80" IsVisible="False" />
    </StackPanel>
  </StackPanel>
</Window>
