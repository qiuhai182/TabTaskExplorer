<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TabTaskExplorer.App.Views.MessageDialog"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <Button Content="确定" Click="OnOkClick" HorizontalAlignment="Right" MinWidth="80" />
  </StackPanel>
</Window>
