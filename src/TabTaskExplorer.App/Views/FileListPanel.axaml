<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:svc="using:TabTaskExplorer.App.Services"
             xmlns:views="using:TabTaskExplorer.App.Views"
             x:Class="TabTaskExplorer.App.Views.FileListPanel"
             Loaded="OnPanelLoaded">

  <!-- 列表区必须占 star 行：若放在 Auto 行，内部 ScrollViewer 会撑到内容全高，视口等于内容高度导致无法滚动，超出窗口的部分被裁剪 -->
  <Grid RowDefinitions="*,Auto">

    <!-- 列表区与信息窗格 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,4,8,0">

      <!-- 列表：双击空白处返回上一级，右键空白处弹出空白处菜单（右键条目时由条目自身菜单接管） -->
      <Grid x:Name="ListAreaGrid" Grid.Column="0" RowDefinitions="Auto,*" DoubleTapped="OnListBackgroundDoubleTapped">
        <Grid.ContextMenu>
          <ContextMenu Opening="OnBackgroundMenuOpening">
            <MenuItem Header="刷新" Tag="MenuRefresh" Click="OnBackgroundRefreshClick" />
            <MenuItem Header="返回上一级" Tag="MenuNavigateUp" Click="OnBackgroundNavigateUpClick" />
            <MenuItem Header="粘贴" Tag="MenuPaste" Click="OnBackgroundPasteClick" />
            <MenuItem Header="新建文件夹…" Tag="MenuNewFolder" Click="OnBackgroundNewFolderClick" />
            <Separator />
            <MenuItem Header="系统右键菜单（全部）" IsVisible="False" Tag="SystemMenuItemsHost" />
          </ContextMenu>
        </Grid.ContextMenu>
        <!-- 表头：星号名称列设上限，窗口过宽时右侧留白；启用列宽拖动，拖动结果经 ColumnWidths 同步到所有行。
             右边距由代码按实测滚动条宽度设置（滚动条独占右侧一列），保证表头与表格右边缘对齐 -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,4" IsVisible="{Binding IsDetailsLayout}"
              svc:ColumnResize.Enabled="True"
              svc:ColumnResize.Widths="{Binding ColumnWidths}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="3*" MaxWidth="560" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="110" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" />
          <TextBlock Grid.Column="1" />
          <Button Grid.Column="2" Tag="Name" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="名称" />
              <TextBlock x:Name="ArrowName" Margin="4,0,0,0" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Tag="Modified" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="修改日期" />
              <TextBlock x:Name="ArrowModified" Margin="4,0,0,0" />
            </StackPanel>
          </Button>
          <Button Grid.Column="4" Tag="Type" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="类型" />
              <TextBlock x:Name="ArrowType" Margin="4,0,0,0" />
            </StackPanel>
          </Button>
          <Button Grid.Column="5" Tag="Size" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="大小" />
              <TextBlock x:Name="ArrowSize" Margin="4,0,0,0" />
            </StackPanel>
          </Button>
        </Grid>
        <!-- 列表区：ListBox 直接占 star 行由自身滚动（与磁盘视图一致）。
             若用外层 ScrollViewer + StackPanel 包裹，ListBox 内部 ScrollViewer 视口被撑到内容全高，
             它会吞掉滚轮事件却无处可滚，外层也收不到滚轮，导致文件夹视图无法滚动；同时虚拟化也会失效。 -->
        <Panel Grid.Row="1" x:Name="ListHost">
            <!-- 详细信息视图：ListBox 自带虚拟化，大目录也流畅 -->
            <ListBox x:Name="RowList" ItemsSource="{Binding VisibleRows}" IsVisible="{Binding IsRowStyleLayout}"
                     SelectionMode="Single" Background="Transparent" Padding="0" BorderThickness="0">
              <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="28" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </ControlTheme>
              </ListBox.ItemContainerTheme>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- 背景由 App.axaml 的 Border.row 系列样式提供：本地直接写 Background 会压过悬停、选中与拖放高亮样式 -->
                  <Border Classes="row" Classes.checked="{Binding IsSelected, Mode=TwoWay}" DoubleTapped="OnRowDoubleTapped" Padding="2,3">
                    <Border.ContextMenu>
                      <ContextMenu Opening="OnSystemMenuOpening">
                        <MenuItem Header="打开" Click="OnMenuOpenClick" />
                        <MenuItem Header="在新标签打开" Click="OnMenuOpenInNewTabClick" />
                        <MenuItem Header="比较所选两项" Tag="MenuCompareSelection" IsVisible="False" Click="OnMenuCompareSelectionClick" />
                        <MenuItem Header="复制" Click="OnMenuCopyClick" />
                        <MenuItem Header="剪切" Click="OnMenuCutClick" />
                        <MenuItem Header="粘贴" Tag="MenuPasteToFolder" Click="OnMenuPasteToFolderClick" />
                        <MenuItem Header="压缩为…" Click="OnMenuCompressClick" />
                        <MenuItem Header="解压到…" Click="OnMenuExtractClick" />
                        <MenuItem Header="重命名" Click="OnMenuRenameClick" />
                        <MenuItem Header="修改权限" Click="OnMenuChangePermissionsClick" />
                        <MenuItem Header="删除" Click="OnMenuDeleteClick" />
                        <Separator />
                        <MenuItem Header="系统右键菜单（全部）" IsVisible="False" Tag="SystemMenuItemsHost" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <!-- 列定义与表头一致：星号名称列设上限避免窗口过宽时被拉满，列宽拖动结果经附加属性同步 -->
                    <Grid svc:ColumnResize.Widths="{Binding DataContext.ColumnWidths, RelativeSource={RelativeSource AncestorType=ListBox}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="3*" MaxWidth="560" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="110" />
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="OnRowCheckChanged" />
                      <views:FileTypeIcon Grid.Column="1" Width="16" Height="16" Category="{Binding IconCategory}"
                                         AccentColor="{Binding IconColor}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Opacity="0.8" VerticalAlignment="Center"
                                 IsVisible="{Binding DataContext.IsDetailsLayout, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                      <TextBlock Grid.Column="4" Text="{Binding TypeText}" Opacity="0.8" VerticalAlignment="Center"
                                 IsVisible="{Binding DataContext.IsListLayout, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={x:Static conv:BoolConverters.Not}}" />
                      <TextBlock Grid.Column="5" Text="{Binding SizeText}" Opacity="0.8" VerticalAlignment="Center"
                                 IsVisible="{Binding DataContext.IsDetailsLayout, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- 图标视图（大图标 / 中图标）：与详细信息视图同样使用 ListBox，保证鼠标悬停预变色与点击选中高亮行为一致 -->
            <!-- 不再手工留右侧边距：滚动条已常驻独占右侧一列，条目不会被压在滚动条下面 -->
            <ListBox x:Name="TileList" ItemsSource="{Binding VisibleRows}" IsVisible="{Binding IsIconsLayout}"
                     SelectionMode="Single" Background="Transparent" Padding="0" BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Classes="tile" Classes.checked="{Binding IsSelected, Mode=TwoWay}" Width="{Binding $parent[ItemsControl].DataContext.TileWidth}" DoubleTapped="OnRowDoubleTapped"
                            Margin="4" Padding="6" HorizontalAlignment="Left">
                      <Border.ContextMenu>
                        <ContextMenu Opening="OnSystemMenuOpening">
                          <MenuItem Header="打开" Click="OnMenuOpenClick" />
                          <MenuItem Header="在新标签打开" Click="OnMenuOpenInNewTabClick" />
                          <MenuItem Header="复制" Click="OnMenuCopyClick" />
                          <MenuItem Header="剪切" Click="OnMenuCutClick" />
                          <MenuItem Header="粘贴" Tag="MenuPasteToFolder" Click="OnMenuPasteToFolderClick" />
                          <MenuItem Header="压缩为…" Click="OnMenuCompressClick" />
                          <MenuItem Header="解压到…" Click="OnMenuExtractClick" />
                          <MenuItem Header="重命名" Click="OnMenuRenameClick" />
                          <MenuItem Header="修改权限" Click="OnMenuChangePermissionsClick" />
                          <MenuItem Header="删除" Click="OnMenuDeleteClick" />
                          <Separator />
                          <MenuItem Header="系统右键菜单（全部）" IsVisible="False" Tag="SystemMenuItemsHost" />
                        </ContextMenu>
                      </Border.ContextMenu>
                      <StackPanel Spacing="4">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="OnRowCheckChanged" HorizontalAlignment="Left" />
                        <views:FileTypeIcon Width="{Binding $parent[ItemsControl].DataContext.TileIconSize}"
                                           Height="{Binding $parent[ItemsControl].DataContext.TileIconSize}"
                                           Category="{Binding IconCategory}" AccentColor="{Binding IconColor}"
                                           HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TypeText}" FontSize="11" Opacity="0.7"
                                   IsVisible="{Binding DataContext.IsTileLayout, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.7" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
      </Grid>

      <!-- 信息窗格 -->
      <Border Grid.Column="1" Width="220" Margin="8,0,0,0" Padding="10"
              IsVisible="{Binding ShowInfoPane}">
        <StackPanel Spacing="6">
          <TextBlock Text="详细信息" FontWeight="Medium" />
          <TextBlock x:Name="InfoNameText" TextWrapping="Wrap" FontWeight="Medium" />
          <TextBlock x:Name="InfoTypeText" Opacity="0.8" />
          <TextBlock x:Name="InfoSizeText" Opacity="0.8" />
          <TextBlock x:Name="InfoModifiedText" Opacity="0.8" />
          <TextBlock x:Name="InfoPathText" TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 摘要栏 -->
    <TextBlock Grid.Row="1" Margin="10,4" Text="{Binding SummaryText}" FontSize="12" Opacity="0.7" />
  </Grid>
</UserControl>
