<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TabTaskExplorer.App.Views.InputDialog"
        Title="输入" Width="420" Height="180" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
    <TextBox x:Name="ValueBox" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="确定" Click="OnOkClick" />
      <Button Content="取消" Click="OnCancelClick" />
    </StackPanel>
  </StackPanel>
</Window>
