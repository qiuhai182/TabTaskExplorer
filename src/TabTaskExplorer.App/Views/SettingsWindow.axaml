<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:TabTaskExplorer.App.Services"
        x:Class="TabTaskExplorer.App.Views.SettingsWindow"
        Title="TabTaskExplorer 设置" Width="900" Height="640" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="150,*">
      <ListBox Grid.Column="0" x:Name="SectionList" Classes="navlist" Margin="8" SelectionChanged="OnSectionChanged">
        <ListBoxItem Content="基本设置" />
        <ListBoxItem Content="快捷操作" />
        <ListBoxItem Content="文件/文件夹" />
        <ListBoxItem Content="编辑器" />
        <ListBoxItem Content="打开方式" />
        <ListBoxItem Content="媒体" />
        <ListBoxItem Content="网页端" />
        <ListBoxItem Content="右键菜单" />
        <ListBoxItem Content="启动项管理" />
        <ListBoxItem Content="截图与录屏" />
        <ListBoxItem Content="关于" />
      </ListBox>
      <ScrollViewer Grid.Column="1" Margin="16">
        <Panel>
          <StackPanel x:Name="BasicPage" Spacing="12">
            <TextBlock Text="基本设置" FontWeight="Medium" />
            <CheckBox Content="开机启动（Windows 注册表 / Linux 自启动 / macOS LaunchAgent）" IsChecked="{Binding AutoStart, Mode=TwoWay}" />
            <CheckBox Content="关闭时最小化到托盘常驻" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
            <CheckBox Content="默认用本程序打开文件夹（Windows，仅当前用户，可随时关闭恢复）" IsChecked="{Binding DefaultFileManager, Mode=TwoWay}" />
            <TextBlock Text="启动设置" FontWeight="Medium" Margin="0,8,0,0" />
            <CheckBox Content="启动时打开上次关闭的标签" IsChecked="{Binding RestoreLastTabs, Mode=TwoWay}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="说明：网页端服务的端口、来源 IP、可访问目录与读写权限，统一在左侧「网页端」分页配置。" />
            <TextBlock Text="页面设置" FontWeight="Medium" Margin="0,8,0,0" />
            <CheckBox Content="显示工具栏" IsChecked="{Binding ShowToolbar, Mode=TwoWay}" />
            <CheckBox Content="显示书签栏" IsChecked="{Binding ShowBookmarkBar, Mode=TwoWay}" />
            <CheckBox Content="顶部显示白色条" IsChecked="{Binding ShowTopWhiteStrip, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel x:Name="MousePage" Spacing="12" IsVisible="False">
            <TextBlock Text="鼠标操作" FontWeight="Medium" />
            <CheckBox Content="双击标签关闭当前标签" IsChecked="{Binding DoubleClickTabClose, Mode=TwoWay}" />
            <CheckBox Content="双击文件空白区域可返回上层目录（已默认启用）" IsEnabled="False" IsChecked="True" />
            <TextBlock Text="快捷键自定义" FontWeight="Medium" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="添加快捷键" Click="OnAddShortcutClick" />
              <Button Content="一键清空" Click="OnClearAllShortcutsClick" />
              <Button Content="恢复默认快捷键" Click="OnResetHotkeysClick" />
            </StackPanel>
            <TextBlock x:Name="ShortcutDisabledHint" IsVisible="False" TextWrapping="Wrap" Opacity="0.8"
                       Text="当前已停用全部快捷键：应用内与系统全局快捷键均不响应，点击「恢复默认快捷键」可重新启用。" />
            <ItemsControl x:Name="ShortcutList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="200,60,Auto,60" Margin="0,3">
                    <ComboBox Grid.Column="0" Width="190" ItemsSource="{x:Static svc:ShortcutActionCatalog.All}"
                              SelectedItem="{Binding ActionOption, Mode=TwoWay}" VerticalAlignment="Center">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Grid.Column="1" Content="全局" IsChecked="{Binding IsGlobal, Mode=TwoWay}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Width="240" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Content="{Binding ShortcutText}" Click="OnCaptureShortcutClick"
                            ToolTip.Tip="点击后直接按下组合键即可设置；Esc 取消捕获" />
                    <Button Grid.Column="3" Content="删除" Click="OnRemoveShortcutClick" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0"
                       Text="说明：点击按钮后直接按下想要的组合键即可设置，Esc 取消捕获；组合键统一按 Ctrl、Alt、Shift、Win 的顺序显示，同一个功能绑定的组合在同作用域内不能重复。同一个功能可以通过「添加快捷键」绑定任意多条组合；「全局」勾选后由系统级键盘拦截触发，可覆盖其他程序注册的快捷键。「Ctrl+Alt+Del」「Win+L」等系统保留组合无法覆盖；以管理员身份运行时可覆盖以管理员身份运行的程序。文件操作类快捷键在输入框内不会触发。Linux / macOS 目前仅支持应用内快捷键。" />
          </StackPanel>
          <StackPanel x:Name="FilePage" Spacing="12" IsVisible="False">
            <CheckBox Content="显示隐藏的文件/文件夹" IsChecked="{Binding ShowHiddenFiles, Mode=TwoWay}" />
            <CheckBox Content="显示文件扩展名" IsChecked="{Binding ShowFileExtensions, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel x:Name="EditorPage" Spacing="12" IsVisible="False">
            <TextBlock Text="编辑器字体" FontWeight="Medium" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="字体回退链" VerticalAlignment="Center" />
              <TextBox Width="380" Text="{Binding EditorFontFamily, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="字号" VerticalAlignment="Center" />
              <TextBox x:Name="EditorFontSizeBox" Width="90" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Tab 宽度（空格数）" VerticalAlignment="Center" />
              <TextBox x:Name="EditorTabWidthBox" Width="90" />
            </StackPanel>
            <CheckBox Content="按下 Tab 用空格替换" IsChecked="{Binding EditorInsertSpaces, Mode=TwoWay}" />
            <CheckBox Content="编辑器自动换行（关闭时按代码编辑习惯横向滚动）" IsChecked="{Binding EditorWordWrap, Mode=TwoWay}" />
            <CheckBox Content="显示空白符（原生编辑器暂不渲染）" IsChecked="{Binding EditorShowWhitespace, Mode=TwoWay}" IsEnabled="False" />
            <TextBlock Text="启动模式" FontWeight="Medium" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="默认打开模式" VerticalAlignment="Center" />
              <ComboBox x:Name="DefaultOpenModeBox" Width="180" HorizontalAlignment="Left">
                <ComboBoxItem Content="资源管理器模式" />
                <ComboBoxItem Content="IDE 模式" />
              </ComboBox>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="说明：IDE 模式为 VSCode 风格轻量编辑器，可从工具栏按钮或标题栏图标一键切换；编码自动探测（BOM → UTF-8 → GBK），超过 5MB 或二进制文件不按文本打开。" />
          </StackPanel>
          <StackPanel x:Name="OpenWithPage" Spacing="12" IsVisible="False">
            <TextBlock Text="打开文件方式" FontWeight="Medium" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="仅对 IDE 模式生效：资源管理器模式始终使用系统默认程序打开文件。IDE 模式下，可对全部类型或某个具体类型分别指定「优先内置编辑器」还是「优先系统默认程序」；选择优先内置但该文件不是可编辑文本（二进制或超过 5MB）时，仍会交给系统默认程序。" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="全部类型默认" VerticalAlignment="Center" />
              <ComboBox x:Name="DefaultPriorityBox" Width="180" HorizontalAlignment="Left">
                <ComboBoxItem Content="优先内置编辑器" />
                <ComboBoxItem Content="优先系统默认程序" />
              </ComboBox>
            </StackPanel>
            <TextBlock Text="按文件类型单独指定" FontWeight="Medium" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="添加类型" Click="OnAddOpenRuleClick" />
              <Button Content="删除选中" Click="OnRemoveOpenRuleClick" />
            </StackPanel>
            <ListBox x:Name="OpenRuleList" Height="240" BorderThickness="1">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="180,190" Margin="0,2">
                    <TextBox Grid.Column="0" Text="{Binding Extension, Mode=TwoWay}" PlaceholderText="例如 .txt 或 *" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="180"
                              SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}" VerticalAlignment="Center">
                      <ComboBoxItem Content="优先内置编辑器" />
                      <ComboBoxItem Content="优先系统默认程序" />
                    </ComboBox>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="说明：扩展名填 * 表示全部类型；同类型只会采用精确匹配的那条规则，修改后点确定生效。" />
          </StackPanel>
          <StackPanel x:Name="MediaPage" Spacing="12" IsVisible="False">
            <TextBlock Text="媒体打开方式" FontWeight="Medium" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="双击图片 / 视频 / 音频时" VerticalAlignment="Center" />
              <ComboBox x:Name="MediaModeBox" Width="220">
                <ComboBoxItem Content="用内置查看器打开" />
                <ComboBoxItem Content="用系统默认程序打开" />
                <ComboBoxItem Content="每次询问" />
              </ComboBox>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="说明：内置查看器在标签页内播放，并在右侧列出同目录的播放列表；选择系统默认程序时行为与普通文件一致。" />
            <TextBlock Text="播放列表" FontWeight="Medium" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="收录范围" VerticalAlignment="Center" />
              <ComboBox x:Name="MediaScopeBox" Width="220">
                <ComboBoxItem Content="只列同类媒体（图片标签只列图片）" />
                <ComboBoxItem Content="列出同目录全部媒体" />
              </ComboBox>
            </StackPanel>
            <CheckBox Content="打开媒体标签时显示播放列表侧边栏" IsChecked="{Binding MediaShowPlaylist, Mode=TwoWay}" />
            <CheckBox Content="播放结束后自动播放下一项" IsChecked="{Binding MediaAutoPlayNext, Mode=TwoWay}" />
            <CheckBox Content="同一文件重复双击时复用已打开的标签" IsChecked="{Binding MediaReuseTab, Mode=TwoWay}" />
            <TextBlock Text="图片" FontWeight="Medium" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="解码最大边长" VerticalAlignment="Center" />
              <ComboBox x:Name="MediaDecodeBox" Width="220">
                <ComboBoxItem Content="2048 像素（省内存）" />
                <ComboBoxItem Content="4096 像素（推荐）" />
                <ComboBoxItem Content="8192 像素" />
                <ComboBoxItem Content="不限制（大图可能占用大量内存）" />
              </ComboBox>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="WebPage" Spacing="10" IsVisible="False">
            <TextBlock Text="网页端端口（每个端口独立配置，可添加任意数量）" FontWeight="Medium" />
            <ListBox x:Name="WebPortList" Height="120" BorderThickness="1" SelectionChanged="OnWebPortSelected" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="新增端口" Click="OnAddWebPortClick" />
              <Button Content="删除端口" Click="OnRemoveWebPortClick" />
            </StackPanel>
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="端口号" VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="WebPortBox" Width="120" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="启用" VerticalAlignment="Center" />
              <CheckBox Grid.Row="1" Grid.Column="1" x:Name="WebPortEnabledBox" Content="启用该端口" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="监听范围" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" x:Name="WebBindScopeBox" Width="220" HorizontalAlignment="Left">
                <ComboBoxItem Content="仅本机（127.0.0.1）" />
                <ComboBoxItem Content="局域网（0.0.0.0，需配合来源 IP 白名单）" />
              </ComboBox>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="权限方案" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" x:Name="WebProfileBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnWebProfileSelectionChanged" />
            </Grid>

            <TextBlock Text="权限方案（可被任意多个端口共用）" FontWeight="Medium" Margin="0,8,0,0" />
            <ListBox x:Name="WebProfileList" Height="96" BorderThickness="1" SelectionChanged="OnWebProfileSelected" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="新增方案" Click="OnAddWebProfileClick" />
              <Button Content="删除方案" Click="OnRemoveWebProfileClick" />
            </StackPanel>
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="方案名称" VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="WebProfileNameBox" Width="220" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="操作权限" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="WebAllowModifyBox" Content="放行修改文件内容" />
                <CheckBox x:Name="WebAllowCreateDeleteBox" Content="放行新建与删除" />
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="账号密码" VerticalAlignment="Center" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <CheckBox x:Name="WebRequirePasswordBox" Content="需要验证" />
                <TextBlock Text="账号" VerticalAlignment="Center" />
                <TextBox x:Name="WebAccountBox" Width="110" />
                <TextBlock Text="密码" VerticalAlignment="Center" />
                <TextBox x:Name="WebPasswordBox" Width="120" PasswordChar="*" />
              </StackPanel>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="来源地址" VerticalAlignment="Top" Margin="0,6,0,0" />
              <TextBox Grid.Row="3" Grid.Column="1" x:Name="WebAllowedAddressBox" Height="52" AcceptsReturn="True" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Grid.Column="0" Text="允许路径" VerticalAlignment="Top" Margin="0,6,0,0" />
              <TextBox Grid.Row="4" Grid.Column="1" x:Name="WebAllowedPathBox" Height="52" AcceptsReturn="True" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Grid.Column="0" />
              <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Opacity="0.7"
                         Text="来源地址每行一条，支持 192.168.1.0/24 网段写法；留空表示不限制。允许路径每行一条，目录按前缀匹配；留空表示整个文件系统只读可浏览。" />
              <TextBlock Grid.Row="6" Grid.Column="0" />
              <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" Opacity="0.7"
                         Text="密码只保存加盐摘要，不落盘明文；修改后才能生效，原密码无法找回。默认方案为只读：可浏览、可打开只读编辑器，不可修改与增删。" />
            </Grid>
          </StackPanel>
          <StackPanel x:Name="RightMenuPage" Spacing="12" IsVisible="False">
            <TextBlock x:Name="RightMenuIntroText" TextWrapping="Wrap" Opacity="0.7"
                       Text="管理系统右键菜单项：禁用的项不再显示在资源管理器右键菜单里；改动注册表后由程序自动通知资源管理器刷新。" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox x:Name="RightMenuGroupBox" Width="150" SelectedIndex="0" SelectionChanged="OnRightMenuGroupChanged">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="文件右键" />
                <ComboBoxItem Content="桌面右键" />
                <ComboBoxItem Content="新建菜单" />
                <ComboBoxItem Content="Win11 新版（只读）" />
              </ComboBox>
              <ComboBox x:Name="RightMenuStatusBox" Width="110" SelectedIndex="0" SelectionChanged="OnRightMenuStatusChanged">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="已启用" />
                <ComboBoxItem Content="已禁用" />
              </ComboBox>
              <TextBox x:Name="RightMenuSearchBox" Width="150" PlaceholderText="按名称搜索" TextChanged="OnRightMenuSearchChanged" />
              <Button x:Name="RightMenuRefreshButton" Content="刷新" Click="OnRightMenuRefreshClick" />
            </StackPanel>
            <TextBlock x:Name="RightMenuEmptyText" Text="没有匹配的菜单项" IsVisible="False" Opacity="0.7" />
            <ListBox x:Name="RightMenuList" Height="320" BorderThickness="1">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="2,4">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BadgeText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding PathText}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                  IsEnabled="{Binding CanToggle}"
                                  IsChecked="{Binding ToggleOn, Mode=TwoWay}"
                                  IsCheckedChanged="OnRightMenuToggle" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <StackPanel x:Name="StartupPage" Spacing="12" IsVisible="False">
            <TextBlock Text="启动项管理" FontWeight="Medium" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="系统开机自启程序、服务、计划任务与自定义启动项，在独立标签页中统一维护：支持刷新、启用或禁用、立即运行，以及新建自定义启动项。此处与侧边栏「启动项管理」入口指向同一份数据与操作。" />
            <Button Content="打开启动项管理标签页" Click="OnOpenStartupManagerClick" HorizontalAlignment="Left" />
            <TextBlock x:Name="StartupOpenStatusText" IsVisible="False" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentGlyphBrush}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="说明：启动项管理不在此分页内嵌列表，避免与标签页出现两份不同步的视图；从任一入口进入都会复用已打开的启动项管理标签，不会重复创建。" />
          </StackPanel>
          <StackPanel x:Name="CapturePage" Spacing="10" IsVisible="False">
            <TextBlock Text="截图与录屏" FontWeight="Medium" />
            <TextBlock x:Name="CaptureEnvironmentText" TextWrapping="Wrap" Opacity="0.72"
                       Text="平台能力与 FFmpeg 状态：启动后自动检测。" />
            <TextBlock Text="产物保存位置" FontWeight="Medium" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="CaptureSaveDirectoryBox" Width="380" PlaceholderText="留空使用「我的图片\TabTaskExplorer\截图录屏」" />
              <Button Content="浏览…" Click="OnBrowseCaptureFolderClick" />
              <Button Content="恢复默认" Click="OnResetCaptureFolderClick" />
            </StackPanel>
            <TextBlock Text="FFmpeg（录屏与 Linux 截图使用）" FontWeight="Medium" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="FfmpegPathBox" Width="380" PlaceholderText="留空自动查找 PATH 与程序 tools 目录" />
              <Button Content="浏览…" Click="OnBrowseFfmpegClick" />
              <Button Content="自动查找" Click="OnClearFfmpegPathClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,6,0,0">
              <CheckBox Content="允许快捷复制到剪贴板（不会自动复制）" IsChecked="{Binding CaptureCopyToClipboard, Mode=TwoWay}"
                        ToolTip.Tip="截图不再自动写剪贴板；复制请使用截图录屏页产物历史的「复制选中到剪贴板」或「复制最近一张」" />
              <CheckBox Content="完成后自动打开产物文件夹标签" IsChecked="{Binding CaptureOpenFolderAfter, Mode=TwoWay}" />
              <CheckBox Content="截图后自动打开标注编辑器（默认关闭）" IsChecked="{Binding CaptureOpenEditorAfter, Mode=TwoWay}" />
              <CheckBox Content="截图与录屏包含鼠标指针" IsChecked="{Binding CaptureIncludeCursor, Mode=TwoWay}" />
              <CheckBox Content="贴图窗口始终置顶" IsChecked="{Binding CapturePinTopmost, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,6,0,0">
              <CheckBox Content="贴图截图保存产物（关闭后只贴图不落盘）"
                        IsChecked="{Binding CapturePinShotSaveFile, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <TextBlock Text="截图失败提示" VerticalAlignment="Center" />
              <ComboBox Width="200" SelectedIndex="{Binding CaptureFailureNoticeIndex, Mode=TwoWay}"
                        ToolTip.Tip="托盘气泡为不抢焦点的无焦点浮层；仅日志没有任何界面提示；弹窗会激活主窗口并抢走前台焦点">
                <ComboBoxItem Content="托盘气泡（默认，不抢焦点）" />
                <ComboBoxItem Content="仅日志" />
                <ComboBoxItem Content="弹窗（会抢焦点）" />
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <TextBlock Text="截图采集后端" VerticalAlignment="Center" />
              <ComboBox Width="200" SelectedIndex="{Binding CaptureBackendIndex, Mode=TwoWay}"
                        ToolTip.Tip="自动：优先 Windows Graphics Capture，不可用或失败时逐次回退 GDI；强制项用于对照与排查问题">
                <ComboBoxItem Content="自动（推荐）" />
                <ComboBoxItem Content="强制 WGC" />
                <ComboBoxItem Content="强制 GDI" />
              </ComboBox>
              <TextBlock Text="截图延迟" VerticalAlignment="Center" />
              <ComboBox x:Name="CaptureDelayBox" Width="120">
                <ComboBoxItem Content="立即截图" />
                <ComboBoxItem Content="3 秒后" />
                <ComboBoxItem Content="5 秒后" />
                <ComboBoxItem Content="10 秒后" />
              </ComboBox>
              <TextBlock Text="录屏帧率" VerticalAlignment="Center" Margin="14,0,0,0" />
              <ComboBox x:Name="CaptureFpsBox" Width="110">
                <ComboBoxItem Content="24 帧/秒" />
                <ComboBoxItem Content="30 帧/秒" />
                <ComboBoxItem Content="60 帧/秒" />
              </ComboBox>
              <TextBlock Text="录屏画质" VerticalAlignment="Center" Margin="14,0,0,0" />
              <ComboBox x:Name="CaptureQualityBox" Width="150">
                <ComboBoxItem Content="高（文件较大）" />
                <ComboBoxItem Content="标准（推荐）" />
                <ComboBoxItem Content="小（文件较小）" />
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <TextBlock Text="麦克风设备" VerticalAlignment="Center" />
              <TextBox x:Name="CaptureMicrophoneBox" Width="380"
                       PlaceholderText="留空表示不录音；Windows 填 DirectShow 设备名，Linux 填 PulseAudio 设备名，macOS 填音频序号" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Opacity="0.72"
                       Text="说明：录屏通过 FFmpeg 采集屏幕并编码为 MP4（H.264）。未安装 FFmpeg 时截图仍可用；录屏按钮会提示缺少 FFmpeg。截图或录屏完成后，默认自动新建（或复用）产物文件夹标签页。" />
            <TextBlock Text="文字识别（截图编辑器中的「识别文字」）" FontWeight="Medium" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="OcrTesseractPathBox" Width="380" PlaceholderText="留空自动查找；Windows 优先使用系统内置识别" />
              <Button Content="浏览…" Click="OnBrowseTesseractClick" />
              <Button Content="清空" Click="OnClearTesseractPathClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="识别语言" VerticalAlignment="Center" />
              <TextBox x:Name="OcrLanguageBox" Width="300"
                       PlaceholderText="留空：Windows 跟随系统语言，Tesseract 使用 eng+chi_sim" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Opacity="0.72"
                       Text="说明：Windows 默认调用系统内置 Windows.Media.Ocr（离线、无需联网）；Linux 与 macOS 需安装 Tesseract-OCR 并指定路径；识别语言可填 chi_sim、eng 或 eng+chi_sim。" />
            <TextBlock Text="快捷键" FontWeight="Medium" Margin="0,8,0,0" />
            <TextBlock TextWrapping="Wrap" Opacity="0.72"
                       Text="截图、录屏以及其它功能的快捷键统一在左侧「快捷操作」分页配置；同一个功能可添加任意多条组合，并可选择应用内或系统全局作用域。" />
          </StackPanel>
          <StackPanel x:Name="AboutPage" Spacing="12" IsVisible="False">
            <TextBlock Text="TabTaskExplorer v0.1" FontWeight="Medium" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="跨平台的 Windows 风格资源管理器 + 任务管理器二合一开源项目。当前为骨架版本，功能持续完善中。" />
            <TextBlock Text="日志与诊断" FontWeight="Medium" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="日志最低级别" VerticalAlignment="Center" />
              <ComboBox x:Name="LogLevelBox" Width="140">
                <ComboBoxItem Content="跟踪" />
                <ComboBoxItem Content="调试" />
                <ComboBoxItem Content="信息" />
                <ComboBoxItem Content="警告" />
                <ComboBoxItem Content="错误" />
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="OpenLogViewerButton" Content="打开日志查看器" Click="OnOpenLogViewerClick" />
              <Button Content="打开日志目录" Click="OnOpenLogDirectoryClick" />
              <Button x:Name="ExportDiagnosticsButton" Content="导出诊断包" Click="OnExportDiagnosticsClick" />
            </StackPanel>
            <TextBlock x:Name="LogDirectoryText" TextWrapping="Wrap" Opacity="0.7" />
            <TextBlock x:Name="DiagnosticsStatusText" TextWrapping="Wrap" IsVisible="False"
                       Foreground="{DynamicResource AccentGlyphBrush}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="说明：日志按日期分文件写入，默认保留最近 7 份；级别设为警告或错误后，调试与信息级记录不再写入。修改级别后点击「确定」生效。" />
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="16,0,16,16">
      <Button Content="确定" Click="OnOkClick" />
      <Button Content="取消" Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>
