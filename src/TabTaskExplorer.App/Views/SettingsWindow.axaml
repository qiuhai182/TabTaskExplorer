<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:TabTaskExplorer.App.Services"
        x:Class="TabTaskExplorer.App.Views.SettingsWindow"
        Title="TabTaskExplorer 设置" Width="700" Height="560"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="150,*">
      <ListBox Grid.Column="0" x:Name="SectionList" Margin="8" SelectionChanged="OnSectionChanged">
        <ListBoxItem Content="基本设置" />
        <ListBoxItem Content="快捷操作" />
        <ListBoxItem Content="文件/文件夹" />
        <ListBoxItem Content="编辑器" />
        <ListBoxItem Content="打开方式" />
        <ListBoxItem Content="网页端" />
        <ListBoxItem Content="关于" />
      </ListBox>
      <ScrollViewer Grid.Column="1" Margin="16">
        <Panel>
          <StackPanel x:Name="BasicPage" Spacing="12">
            <TextBlock Text="基本设置" FontWeight="Medium" />
            <CheckBox Content="开机启动（Windows 注册表 / Linux 自启动 / macOS LaunchAgent）" IsChecked="{Binding AutoStart, Mode=TwoWay}" />
            <CheckBox Content="关闭时最小化到托盘常驻" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
            <CheckBox Content="默认用本程序打开文件夹（Windows，仅当前用户，可随时关闭恢复）" IsChecked="{Binding DefaultFileManager, Mode=TwoWay}" />
            <TextBlock Text="启动设置" FontWeight="Medium" Margin="0,8,0,0" />
            <CheckBox Content="启动时打开上次关闭的标签" IsChecked="{Binding RestoreLastTabs, Mode=TwoWay}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="说明：网页端服务的端口、来源 IP、可访问目录与读写权限，统一在左侧「网页端」分页配置。" />
            <TextBlock Text="页面设置" FontWeight="Medium" Margin="0,8,0,0" />
            <CheckBox Content="显示工具栏" IsChecked="{Binding ShowToolbar, Mode=TwoWay}" />
            <CheckBox Content="显示书签栏" IsChecked="{Binding ShowBookmarkBar, Mode=TwoWay}" />
            <CheckBox Content="顶部显示白色条" IsChecked="{Binding ShowTopWhiteStrip, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel x:Name="MousePage" Spacing="12" IsVisible="False">
            <TextBlock Text="鼠标操作" FontWeight="Medium" />
            <CheckBox Content="双击标签关闭当前标签" IsChecked="{Binding DoubleClickTabClose, Mode=TwoWay}" />
            <CheckBox Content="双击文件空白区域可返回上层目录（已默认启用）" IsEnabled="False" IsChecked="True" />
            <TextBlock Text="快捷键自定义" FontWeight="Medium" Margin="0,8,0,0" />
            <Button Content="恢复默认快捷键" Click="OnResetHotkeysClick" HorizontalAlignment="Left" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Hotkeys}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="150,Auto,Auto,Auto,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Content="Ctrl" IsChecked="{Binding Ctrl, Mode=TwoWay}" Margin="0,0,10,0" />
                    <CheckBox Grid.Column="2" Content="Alt" IsChecked="{Binding Alt, Mode=TwoWay}" Margin="0,0,10,0" />
                    <CheckBox Grid.Column="3" Content="Shift" IsChecked="{Binding Shift, Mode=TwoWay}" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="4" Width="110" ItemsSource="{x:Static svc:HotkeySetting.KeyOptions}" SelectedItem="{Binding KeyText, Mode=TwoWay}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0"
                       Text="说明：文件操作类快捷键（刷新、重命名、删除、复制、剪切、粘贴）在输入框内不会触发，避免误操作。改动点确定后立即生效。" />
          </StackPanel>
          <StackPanel x:Name="FilePage" Spacing="12" IsVisible="False">
            <CheckBox Content="显示隐藏的文件/文件夹" IsChecked="{Binding ShowHiddenFiles, Mode=TwoWay}" />
            <CheckBox Content="显示文件扩展名" IsChecked="{Binding ShowFileExtensions, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel x:Name="EditorPage" Spacing="12" IsVisible="False">
            <TextBlock Text="编辑器字体" FontWeight="Medium" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="字体回退链" VerticalAlignment="Center" />
              <TextBox Width="380" Text="{Binding EditorFontFamily, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="字号" VerticalAlignment="Center" />
              <TextBox x:Name="EditorFontSizeBox" Width="90" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Tab 宽度（空格数）" VerticalAlignment="Center" />
              <TextBox x:Name="EditorTabWidthBox" Width="90" />
            </StackPanel>
            <CheckBox Content="按下 Tab 用空格替换" IsChecked="{Binding EditorInsertSpaces, Mode=TwoWay}" />
            <CheckBox Content="编辑器自动换行（关闭时按代码编辑习惯横向滚动）" IsChecked="{Binding EditorWordWrap, Mode=TwoWay}" />
            <CheckBox Content="显示空白符（原生编辑器暂不渲染）" IsChecked="{Binding EditorShowWhitespace, Mode=TwoWay}" IsEnabled="False" />
            <TextBlock Text="启动模式" FontWeight="Medium" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="默认打开模式" VerticalAlignment="Center" />
              <ComboBox x:Name="DefaultOpenModeBox" Width="180" HorizontalAlignment="Left">
                <ComboBoxItem Content="资源管理器模式" />
                <ComboBoxItem Content="IDE 模式" />
              </ComboBox>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="说明：IDE 模式为 VSCode 风格轻量编辑器，可从工具栏按钮或标题栏图标一键切换；编码自动探测（BOM → UTF-8 → GBK），超过 5MB 或二进制文件不按文本打开。" />
          </StackPanel>
          <StackPanel x:Name="OpenWithPage" Spacing="12" IsVisible="False">
            <TextBlock Text="打开文件方式" FontWeight="Medium" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="仅对 IDE 模式生效：资源管理器模式始终使用系统默认程序打开文件。IDE 模式下，可对全部类型或某个具体类型分别指定「优先内置编辑器」还是「优先系统默认程序」；选择优先内置但该文件不是可编辑文本（二进制或超过 5MB）时，仍会交给系统默认程序。" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="全部类型默认" VerticalAlignment="Center" />
              <ComboBox x:Name="DefaultPriorityBox" Width="180" HorizontalAlignment="Left">
                <ComboBoxItem Content="优先内置编辑器" />
                <ComboBoxItem Content="优先系统默认程序" />
              </ComboBox>
            </StackPanel>
            <TextBlock Text="按文件类型单独指定" FontWeight="Medium" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="添加类型" Click="OnAddOpenRuleClick" />
              <Button Content="删除选中" Click="OnRemoveOpenRuleClick" />
            </StackPanel>
            <ListBox x:Name="OpenRuleList" Height="240" BorderThickness="1">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="180,190" Margin="0,2">
                    <TextBox Grid.Column="0" Text="{Binding Extension, Mode=TwoWay}" PlaceholderText="例如 .txt 或 *" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="180"
                              SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}" VerticalAlignment="Center">
                      <ComboBoxItem Content="优先内置编辑器" />
                      <ComboBoxItem Content="优先系统默认程序" />
                    </ComboBox>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="说明：扩展名填 * 表示全部类型；同类型只会采用精确匹配的那条规则，修改后点确定生效。" />
          </StackPanel>
          <StackPanel x:Name="WebPage" Spacing="10" IsVisible="False">
            <TextBlock Text="网页端端口（每个端口独立配置，可添加任意数量）" FontWeight="Medium" />
            <ListBox x:Name="WebPortList" Height="120" BorderThickness="1" SelectionChanged="OnWebPortSelected" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="新增端口" Click="OnAddWebPortClick" />
              <Button Content="删除端口" Click="OnRemoveWebPortClick" />
            </StackPanel>
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="端口号" VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="WebPortBox" Width="120" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="启用" VerticalAlignment="Center" />
              <CheckBox Grid.Row="1" Grid.Column="1" x:Name="WebPortEnabledBox" Content="启用该端口" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="监听范围" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" x:Name="WebBindScopeBox" Width="220" HorizontalAlignment="Left">
                <ComboBoxItem Content="仅本机（127.0.0.1）" />
                <ComboBoxItem Content="局域网（0.0.0.0，需配合来源 IP 白名单）" />
              </ComboBox>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="权限方案" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" x:Name="WebProfileBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnWebProfileSelectionChanged" />
            </Grid>

            <TextBlock Text="权限方案（可被任意多个端口共用）" FontWeight="Medium" Margin="0,8,0,0" />
            <ListBox x:Name="WebProfileList" Height="96" BorderThickness="1" SelectionChanged="OnWebProfileSelected" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="新增方案" Click="OnAddWebProfileClick" />
              <Button Content="删除方案" Click="OnRemoveWebProfileClick" />
            </StackPanel>
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="方案名称" VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="WebProfileNameBox" Width="220" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="操作权限" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="WebAllowModifyBox" Content="放行修改文件内容" />
                <CheckBox x:Name="WebAllowCreateDeleteBox" Content="放行新建与删除" />
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="账号密码" VerticalAlignment="Center" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <CheckBox x:Name="WebRequirePasswordBox" Content="需要验证" />
                <TextBlock Text="账号" VerticalAlignment="Center" />
                <TextBox x:Name="WebAccountBox" Width="110" />
                <TextBlock Text="密码" VerticalAlignment="Center" />
                <TextBox x:Name="WebPasswordBox" Width="120" PasswordChar="*" />
              </StackPanel>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="来源地址" VerticalAlignment="Top" Margin="0,6,0,0" />
              <TextBox Grid.Row="3" Grid.Column="1" x:Name="WebAllowedAddressBox" Height="52" AcceptsReturn="True" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Grid.Column="0" Text="允许路径" VerticalAlignment="Top" Margin="0,6,0,0" />
              <TextBox Grid.Row="4" Grid.Column="1" x:Name="WebAllowedPathBox" Height="52" AcceptsReturn="True" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Grid.Column="0" />
              <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Opacity="0.7"
                         Text="来源地址每行一条，支持 192.168.1.0/24 网段写法；留空表示不限制。允许路径每行一条，目录按前缀匹配；留空表示整个文件系统只读可浏览。" />
              <TextBlock Grid.Row="6" Grid.Column="0" />
              <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" Opacity="0.7"
                         Text="密码只保存加盐摘要，不落盘明文；修改后才能生效，原密码无法找回。默认方案为只读：可浏览、可打开只读编辑器，不可修改与增删。" />
            </Grid>
          </StackPanel>
          <StackPanel x:Name="AboutPage" Spacing="12" IsVisible="False">
            <TextBlock Text="TabTaskExplorer v0.1" FontWeight="Medium" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="跨平台的 Windows 风格资源管理器 + 任务管理器二合一开源项目。当前为骨架版本，功能持续完善中。" />
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="16,0,16,16">
      <Button Content="确定" Click="OnOkClick" />
      <Button Content="取消" Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>
