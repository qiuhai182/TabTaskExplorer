<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:TabTaskExplorer.App.Services"
             x:Class="TabTaskExplorer.App.Views.SearchPanel">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">

    <!-- 搜索行：关键字输入框 + 搜索按钮 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBox x:Name="SearchBox" Width="380" PlaceholderText="输入全盘文件名关键字，回车或点击搜索"
               Text="{Binding QueryText, Mode=TwoWay}" KeyDown="OnSearchKeyDown" />
      <Button x:Name="SearchButton" Content="搜索" Click="OnSearchButtonClick"
              IsEnabled="{Binding !IsSearching}" ToolTip.Tip="执行全局搜索" />
    </StackPanel>

    <!-- 表头：与结果行同列结构，点击按该列排序；星号名称列设上限，窗口过宽时右侧留白；拖动列边界调整列宽 -->
    <Grid Grid.Row="1" Margin="2,0,2,4"
          svc:ColumnResize.Enabled="True"
          svc:ColumnResize.Widths="{Binding ColumnWidths}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MaxWidth="560" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Width="21" FontSize="13" Margin="0,0,8,0" />
      <Button Grid.Column="1" Tag="Name" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="名称" />
          <TextBlock x:Name="ArrowName" Margin="4,0,0,0" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Tag="Modified" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" Margin="12,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="修改日期" />
          <TextBlock x:Name="ArrowModified" Margin="4,0,0,0" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Tag="Size" Click="OnSortClick" FontWeight="Medium" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" MinWidth="70">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="大小" />
          <TextBlock x:Name="ArrowSize" Margin="4,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- 搜索结果列表（ListBox 自带虚拟化） -->
    <ListBox Grid.Row="2" ItemsSource="{Binding Results}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="Transparent">
            <Border.ContextMenu>
              <ContextMenu>
                <MenuItem Header="打开" Click="OnMenuOpenClick" />
                <MenuItem Header="在新标签打开" Click="OnMenuOpenInNewTabClick" />
                <MenuItem Header="复制路径" Click="OnMenuCopyPathClick" />
              </ContextMenu>
            </Border.ContextMenu>
            <!-- 列定义与表头一致：星号名称列设上限，列宽拖动结果经附加属性同步到所有结果行 -->
            <Grid Margin="2,3" ToolTip.Tip="{Binding FullPath}"
                  svc:ColumnResize.Widths="{Binding DataContext.ColumnWidths, RelativeSource={RelativeSource AncestorType=ListBox}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                         Text="{Binding IconGlyph}" Foreground="{Binding IconColor}"
                         FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" VerticalAlignment="Center"
                         Margin="12,0" Foreground="#90808080" FontSize="11" />
              <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center"
                         HorizontalAlignment="Right" MinWidth="70" TextAlignment="Right" FontSize="11" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- 状态栏：搜索引擎名称、进度与结果数量 -->
    <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,4" CornerRadius="6" Background="#20808080">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" />
    </Border>
  </Grid>
</UserControl>
