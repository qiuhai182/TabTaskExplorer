<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TabTaskExplorer.App.Views"
        xmlns:vm="using:TabTaskExplorer.App.ViewModels"
        x:Class="TabTaskExplorer.App.Views.MainWindow"
        Title="TabTaskExplorer"
        Width="1200" Height="760"
        Background="{DynamicResource ContentBrush}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        KeyDown="OnWindowKeyDown">

  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe Fluent Icons</FontFamily>
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <!-- ===== 行 0：TabX 风格标题栏（36px，标签条融入标题栏） ===== -->
    <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            Height="36" Background="Transparent"
            PointerPressed="OnCaptionPointerPressed" DoubleTapped="OnCaptionDoubleTapped">

        <!-- 徽标：点击回到此电脑 -->
        <Button Grid.Column="0" Classes="nav" Width="32" Height="36" Click="OnLogoClick" ToolTip.Tip="此电脑">
          <Image Source="{DynamicResource LogoIcon}" Width="16" Height="14" />
        </Button>
        <Border Grid.Column="1" Width="1" Height="20" Background="{DynamicResource SeparatorBrush}" Margin="2,0" VerticalAlignment="Center" />

        <!-- 标签条 -->
        <ListBox Grid.Column="3" x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                 SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="2,4,0,0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="MinHeight" Value="28" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </ControlTheme>
          </ListBox.ItemContainerTheme>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0,4,0" Height="28" DoubleTapped="OnTabHeaderDoubleTapped">
                <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Width="18" Height="18" Padding="0" Background="Transparent"
                        Click="OnCloseTabClick" VerticalAlignment="Center" ToolTip.Tip="关闭">
                  <Button.Styles>
                    <Style Selector="Image.part"><Setter Property="Source" Value="{DynamicResource TabCloseN}" /></Style>
                    <Style Selector="Button:pointerover Image.part"><Setter Property="Source" Value="{DynamicResource TabCloseH}" /></Style>
                    <Style Selector="Button:pressed Image.part"><Setter Property="Source" Value="{DynamicResource TabCloseP}" /></Style>
                  </Button.Styles>
                  <Image Classes="part" Width="16" Height="16" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 新建标签 -->
        <Button Grid.Column="4" Classes="nav" Width="28" Height="28" Padding="0" Margin="2,0,6,0"
                VerticalAlignment="Center" Click="OnNewTabClick" ToolTip.Tip="新建标签 (Ctrl+T)">
          <Button.Styles>
            <Style Selector="Image.part"><Setter Property="Source" Value="{DynamicResource BtnTabAddN}" /></Style>
            <Style Selector="Button:pointerover Image.part"><Setter Property="Source" Value="{DynamicResource BtnTabAddH}" /></Style>
            <Style Selector="Button:pressed Image.part"><Setter Property="Source" Value="{DynamicResource BtnTabAddH}" /></Style>
          </Button.Styles>
          <Image Classes="part" Width="24" Height="24" />
        </Button>

        <!-- 工具盒子（任务看板） -->
        <Button Grid.Column="5" Classes="nav" Width="28" Height="28" Padding="0"
                VerticalAlignment="Center" Click="OnToolboxClick" ToolTip.Tip="任务看板">
          <Button.Styles>
            <Style Selector="Image.part"><Setter Property="Source" Value="{DynamicResource BtnToolboxN}" /></Style>
            <Style Selector="Button:pointerover Image.part"><Setter Property="Source" Value="{DynamicResource BtnToolboxH}" /></Style>
            <Style Selector="Button:pressed Image.part"><Setter Property="Source" Value="{DynamicResource BtnToolboxP}" /></Style>
          </Button.Styles>
          <Image Classes="part" Width="16" Height="16" />
        </Button>
        <Border Grid.Column="6" Width="1" Height="20" Background="{DynamicResource SeparatorBrush}" Margin="2,0" VerticalAlignment="Center" />

        <!-- 主题切换（TabX 同款按钮位） -->
        <Button Grid.Column="7" Classes="nav" Width="40" Height="36" Padding="0"
                Click="OnToggleThemeClick" ToolTip.Tip="切换深浅色主题">
          <Button.Styles>
            <Style Selector="Image.part"><Setter Property="Source" Value="{DynamicResource BtnThemeN}" /></Style>
            <Style Selector="Button:pointerover Image.part"><Setter Property="Source" Value="{DynamicResource BtnThemeH}" /></Style>
            <Style Selector="Button:pressed Image.part"><Setter Property="Source" Value="{DynamicResource BtnThemeP}" /></Style>
          </Button.Styles>
          <Image Classes="part" Width="40" Height="34" />
        </Button>

        <!-- 接管 / 恢复默认资源管理器 -->
        <Button Grid.Column="8" x:Name="DefaultExplorerBtn" Classes="nav" Width="40" Height="36" Padding="0"
                Click="OnDefaultExplorerClick" ToolTip.Tip="设为默认资源管理器">
          <Button.Styles>
            <Style Selector="Image.part"><Setter Property="Source" Value="{DynamicResource BtnDefaultN}" /></Style>
            <Style Selector="Button:pointerover Image.part"><Setter Property="Source" Value="{DynamicResource BtnDefaultH}" /></Style>
            <Style Selector="Button:pressed Image.part"><Setter Property="Source" Value="{DynamicResource BtnDefaultP}" /></Style>
          </Button.Styles>
          <Image Classes="part" Width="40" Height="34" />
        </Button>
        <Button Grid.Column="8" x:Name="RestoreExplorerBtn" Classes="nav" Width="40" Height="36" Padding="0"
                IsVisible="False" Click="OnDefaultExplorerClick" ToolTip.Tip="恢复默认资源管理器">
          <Button.Styles>
            <Style Selector="Image.part"><Setter Property="Source" Value="{DynamicResource BtnRecoveryN}" /></Style>
            <Style Selector="Button:pointerover Image.part"><Setter Property="Source" Value="{DynamicResource BtnRecoveryH}" /></Style>
            <Style Selector="Button:pressed Image.part"><Setter Property="Source" Value="{DynamicResource BtnRecoveryP}" /></Style>
          </Button.Styles>
          <Image Classes="part" Width="40" Height="34" />
        </Button>

        <!-- 设置 -->
        <Button Grid.Column="9" Classes="nav" Width="40" Height="36" Padding="0" Click="OnSettingsClick" ToolTip.Tip="设置">
          <Button.Styles>
            <Style Selector="Image.part"><Setter Property="Source" Value="{DynamicResource BtnSettingN}" /></Style>
            <Style Selector="Button:pointerover Image.part"><Setter Property="Source" Value="{DynamicResource BtnSettingH}" /></Style>
            <Style Selector="Button:pressed Image.part"><Setter Property="Source" Value="{DynamicResource BtnSettingP}" /></Style>
          </Button.Styles>
          <Image Classes="part" Width="40" Height="34" />
        </Button>

        <!-- 窗口控制 -->
        <Button Grid.Column="10" Classes="nav" Width="40" Height="36" Padding="0" Click="OnMinimizeClick" ToolTip.Tip="最小化">
          <Button.Styles>
            <Style Selector="Image.part"><Setter Property="Source" Value="{DynamicResource BtnMinN}" /></Style>
            <Style Selector="Button:pointerover Image.part"><Setter Property="Source" Value="{DynamicResource BtnMinH}" /></Style>
            <Style Selector="Button:pressed Image.part"><Setter Property="Source" Value="{DynamicResource BtnMinP}" /></Style>
          </Button.Styles>
          <Image Classes="part" Width="40" Height="34" />
        </Button>
        <Button Grid.Column="11" Classes="nav" Width="40" Height="36" Padding="0" Click="OnMaximizeClick" ToolTip.Tip="最大化">
          <Button.Styles>
            <Style Selector="Image.part"><Setter Property="Source" Value="{DynamicResource BtnMaxN}" /></Style>
            <Style Selector="Button:pointerover Image.part"><Setter Property="Source" Value="{DynamicResource BtnMaxH}" /></Style>
            <Style Selector="Button:pressed Image.part"><Setter Property="Source" Value="{DynamicResource BtnMaxP}" /></Style>
          </Button.Styles>
          <Image Classes="part" Width="40" Height="34" />
        </Button>
        <Button Grid.Column="12" Classes="nav" Width="40" Height="36" Padding="0" Click="OnCloseWindowClick" ToolTip.Tip="关闭">
          <Button.Styles>
            <Style Selector="Image.part"><Setter Property="Source" Value="{DynamicResource BtnCloseN}" /></Style>
            <Style Selector="Button:pointerover Image.part"><Setter Property="Source" Value="{DynamicResource BtnCloseH}" /></Style>
            <Style Selector="Button:pressed Image.part"><Setter Property="Source" Value="{DynamicResource BtnCloseP}" /></Style>
          </Button.Styles>
          <Image Classes="part" Width="40" Height="34" />
        </Button>
      </Grid>
    </Border>

    <!-- ===== 行 1：TabX 书签栏（快捷访问固定项） ===== -->
    <Border Grid.Row="1" Background="{DynamicResource ContentBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,2">
        <Image Source="{DynamicResource BookmarkLogoIcon}" Width="20" Height="20" VerticalAlignment="Center" />
        <TextBlock Text=" 可拖动常用文件/文档/文件夹到此，创建成书签，以便能快速找到并打开"
                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                   IsVisible="{Binding HasNoBookmarks}" />
        <ItemsControl ItemsSource="{Binding QuickAccessItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Panel Margin="0,0,2,0">
                <Button Classes="nav" Click="OnBookmarkItemClick">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" Foreground="{DynamicResource AccentGlyphBrush}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Button>
                <Button Classes="nav" FontFamily="{StaticResource IconFont}" Content="&#xE711;" Width="16" Height="16" FontSize="8"
                        HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip.Tip="取消固定" Click="OnBookmarkUnpinClick" />
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ===== 行 2：工具栏（TabX 同款：图标 + 文字） ===== -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2" Margin="6,2,6,2">
      <Button Classes="nav tool" Click="OnToolbarViewClick" ToolTip.Tip="切换视图：详细信息 / 大图标 / 中图标">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B3;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="查看" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarNewFolderClick" ToolTip.Tip="新建文件夹">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F4;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="新建文件夹" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarBatchRenameClick" ToolTip.Tip="批量改名（先勾选条目）">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8AC;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="批量改名" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarDeleteClick" ToolTip.Tip="删除勾选项（Windows 移入回收站）">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="回收站" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarHiddenClick" ToolTip.Tip="显示 / 隐藏隐藏条目">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B3;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="显示隐藏条目" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarInfoPaneClick" ToolTip.Tip="显示 / 隐藏详细信息窗格">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C9;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="显示详细信息窗格" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarRefreshClick" ToolTip.Tip="刷新 (F5)">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="刷新" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- ===== 行 3：导航 + 可编辑地址栏（点击空白即编辑）+ 最近 / 刷新 / 收藏 + 搜索 ===== -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,240" Margin="6,2,6,4">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
        <Button Classes="nav tool" FontFamily="{StaticResource IconFont}" Content="&#xE72B;" Click="OnBackClick" ToolTip.Tip="后退" />
        <Button Classes="nav tool" FontFamily="{StaticResource IconFont}" Content="&#xE72A;" Click="OnForwardClick" ToolTip.Tip="前进" />
        <Button Classes="nav tool" FontFamily="{StaticResource IconFont}" Content="&#xE74A;" Click="OnUpClick" ToolTip.Tip="上一级" />
      </StackPanel>
      <Border Grid.Column="1" Margin="6,0,0,0" Background="{DynamicResource ChromeBrush}" CornerRadius="3" MinHeight="30"
              BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <Panel Grid.Column="0">
            <!-- 点击路径区空白处即进入编辑，无需专门按钮 -->
            <Button x:Name="AddressEditArea" Classes="nav" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Click="OnBreadcrumbEditClick" ToolTip.Tip="点击编辑路径" />
            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="1" Margin="4,2" VerticalAlignment="Center" />
            <TextBox x:Name="AddressBox" IsVisible="False" PlaceholderText="输入路径后按回车跳转" KeyDown="OnAddressKeyDown" />
          </Panel>
          <Button Grid.Column="1" x:Name="RecentButton" Classes="nav" FontFamily="{StaticResource IconFont}" Content="&#xE81C;" Width="30" Click="OnRecentClick" ToolTip.Tip="最近访问">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ListBox x:Name="RecentList" ItemsSource="{Binding RecentPaths}" MaxHeight="320" MinWidth="380"
                         Background="Transparent" BorderThickness="0" SelectionChanged="OnRecentSelected">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="2,3" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="2" Classes="nav" FontFamily="{StaticResource IconFont}" Content="&#xE72C;" Width="30" Click="OnAddressRefreshClick" ToolTip.Tip="刷新 (F5)" />
          <Button Grid.Column="3" Classes="nav" FontFamily="{StaticResource IconFont}" Content="&#xE735;" Width="30" Click="OnPinClick" ToolTip.Tip="收藏当前文件夹到书签" />
        </Grid>
      </Border>
      <TextBox Grid.Column="2" x:Name="SearchBox" Width="200" PlaceholderText="搜索当前目录" TextChanged="OnSearchTextChanged" />
    </Grid>

    <!-- ===== 行 4：左侧导航栏 + 内容区 ===== -->
    <Grid Grid.Row="4" ColumnDefinitions="200,*">
      <Border Grid.Column="0" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="4">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE735;" Foreground="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
              <TextBlock Text="快捷访问" FontWeight="Medium" Foreground="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <ListBox x:Name="PinnedNavList" ItemsSource="{Binding QuickAccessItems}" SelectionMode="Single"
                     Background="Transparent" BorderThickness="0" SelectionChanged="OnNavSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,0">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding IconGlyph}" Foreground="{DynamicResource AccentGlyphBrush}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,14,4,2">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F8;" Foreground="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
              <TextBlock Text="此电脑" FontWeight="Medium" Foreground="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <ListBox x:Name="PcNavList" ItemsSource="{Binding ThisPcItems}" SelectionMode="Single"
                     Background="Transparent" BorderThickness="0" SelectionChanged="OnNavSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,0">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding IconGlyph}" Foreground="{DynamicResource AccentGlyphBrush}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,14,4,2">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE968;" Foreground="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
              <TextBlock Text="网络" FontWeight="Medium" Foreground="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnConnectionsClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE968;" Foreground="{DynamicResource AccentGlyphBrush}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="连接管理" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- 内容区：随选中标签切换面板 -->
      <ContentControl Grid.Column="1" Content="{Binding SelectedTab}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:FileTabViewModel">
            <views:FileListPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:TaskBoardViewModel">
            <views:TaskBoardPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:ConnectionManagerViewModel">
            <views:ConnectionPanel />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>

    <!-- ===== 行 5：状态栏（N 个项目 + 调试镜像地址） ===== -->
    <Border Grid.Row="5" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="12,4,8,4">
        <TextBlock Grid.Column="0" x:Name="StatusCountText" Text="0 个项目" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Grid.Column="1" Text="调试镜像 http://127.0.0.1:15919" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.7" />
      </Grid>
    </Border>
  </Grid>
</Window>
