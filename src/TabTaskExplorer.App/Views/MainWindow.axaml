<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TabTaskExplorer.App.Views"
        xmlns:vm="using:TabTaskExplorer.App.ViewModels"
        x:Class="TabTaskExplorer.App.Views.MainWindow"
        Title="TabTaskExplorer"
        Width="1200" Height="800"
        Background="{DynamicResource ContentBrush}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        WindowDecorations="None"
        DragDrop.AllowDrop="True"
        KeyDown="OnWindowKeyDown">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <!-- ===== 行 0：TabX 风格标题栏（36px，标签条融入标题栏） ===== -->
    <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            Height="36" Background="Transparent"
            PointerPressed="OnCaptionPointerPressed" DoubleTapped="OnCaptionDoubleTapped">

        <!-- 徽标：点击回到此电脑 -->
        <Button Grid.Column="0" Classes="nav" Width="32" Height="36" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="OnLogoClick" ToolTip.Tip="此电脑">
          <views:LogoMark Width="19" Height="19" />
        </Button>
        <Border Grid.Column="1" Width="1" Height="24" Background="{DynamicResource SeparatorBrush}" Margin="2,0" VerticalAlignment="Center" />

        <!-- 标签条：新建标签按钮紧跟最后一个标签右侧；标签过多时标签条截断，按钮保持可见 -->
        <Grid Grid.Column="3" x:Name="TabStripHost" ColumnDefinitions="Auto,*" ClipToBounds="True">
          <ListBox Grid.Column="0" x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                   SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0,5,0,0"
                   ScrollViewer.HorizontalScrollBarVisibility="Hidden">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0,4,0" Height="28" DoubleTapped="OnTabHeaderDoubleTapped">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="新建标签" Click="OnTabMenuNewTab" />
                      <MenuItem Header="新建比对标签" Click="OnCompareClick" />
                      <MenuItem Header="复制当前标签" Click="OnTabMenuDuplicate" />
                      <MenuItem Header="添加到书签栏" Click="OnTabMenuAddToBookmarks" />
                      <MenuItem Header="关闭当前标签" Click="OnTabMenuClose" />
                      <MenuItem Header="关闭其他标签" Click="OnTabMenuCloseOthers" />
                      <MenuItem Header="固定 / 取消固定标签" Click="OnTabMenuTogglePin" />
                      <MenuItem Header="粘贴" Click="OnTabMenuPasteClick" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <views:FileTypeIcon Grid.Column="0" Width="14" Height="14" Category="folder"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="246" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="2" Width="18" Height="18" Padding="0" Background="Transparent"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          Click="OnCloseTabClick" VerticalAlignment="Center" ToolTip.Tip="关闭">
                    <views:VectorIcon Kind="close" Width="10" Height="10" Thickness="1.4"
                                      IconBrush="{DynamicResource TextMutedBrush}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 新建标签：紧跟最后一个标签右侧；标签过多时贴住右侧边界 -->
          <Button Grid.Column="1" Classes="nav" Width="28" Height="28" Padding="0" Margin="2,0,6,0"
                  HorizontalAlignment="Left"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  VerticalAlignment="Center" Click="OnNewTabClick" ToolTip.Tip="新建标签 (Ctrl+T)">
            <views:VectorIcon Kind="plus" Width="14" Height="14" Thickness="1.7"
                              IconBrush="{DynamicResource TextMutedBrush}" />
          </Button>
        </Grid>

        <!-- 工具盒子（任务看板）+ IDE 模式切换 -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="nav" Width="28" Height="28" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  VerticalAlignment="Center" Click="OnToolboxClick" ToolTip.Tip="任务看板">
            <views:VectorIcon Kind="board" Width="15" Height="15" Thickness="1.6"
                              IconBrush="{DynamicResource TextMutedBrush}" />
          </Button>
          <Button Classes="nav" Width="28" Height="28" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  VerticalAlignment="Center" Click="OnCaptureClick" ToolTip.Tip="截图与录屏">
            <views:VectorIcon Kind="camera" Width="15" Height="15" Thickness="1.6"
                              IconBrush="{DynamicResource TextMutedBrush}" />
          </Button>
          <Button Classes="nav" Width="28" Height="28" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  VerticalAlignment="Center" Click="OnToggleIdeModeClick" ToolTip.Tip="IDE 模式 / 资源管理器模式">
            <views:VectorIcon Kind="code" Width="15" Height="15" Thickness="1.6"
                              IconBrush="{DynamicResource TextMutedBrush}" />
          </Button>
        </StackPanel>
        <Border Grid.Column="6" Width="1" Height="24" Background="{DynamicResource SeparatorBrush}" Margin="2,0" VerticalAlignment="Center" />

        <!-- 主题切换 -->
        <Button Grid.Column="7" Classes="nav caption" Width="40" Height="36" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="OnToggleThemeClick" ToolTip.Tip="切换深浅色主题">
          <views:VectorIcon Kind="sun" Width="16" Height="16" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" />
        </Button>

        <!-- 接管 / 恢复默认资源管理器 -->
        <Button Grid.Column="8" x:Name="DefaultExplorerBtn" Classes="nav caption" Width="40" Height="36" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="OnDefaultExplorerClick" ToolTip.Tip="设为默认资源管理器">
          <views:VectorIcon Kind="checkcircle" Width="16" Height="16" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" />
        </Button>
        <Button Grid.Column="8" x:Name="RestoreExplorerBtn" Classes="nav caption" Width="40" Height="36" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                IsVisible="False" Click="OnDefaultExplorerClick" ToolTip.Tip="恢复默认资源管理器">
          <views:VectorIcon Kind="undo" Width="16" Height="16" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" />
        </Button>

        <!-- 设置 -->
        <Button Grid.Column="9" Classes="nav caption" Width="40" Height="36" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="OnSettingsClick" ToolTip.Tip="设置">
          <views:VectorIcon Kind="sliders" Width="16" Height="16" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" />
        </Button>

        <!-- 窗口控制 -->
        <Button Grid.Column="10" Classes="nav caption" Width="40" Height="36" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="OnMinimizeClick" ToolTip.Tip="最小化">
          <views:VectorIcon Kind="minimize" Width="14" Height="14" Thickness="1.5"
                            IconBrush="{DynamicResource TextMutedBrush}" />
        </Button>
        <Button Grid.Column="11" Classes="nav caption" Width="40" Height="36" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="OnMaximizeClick" ToolTip.Tip="最大化">
          <views:VectorIcon Kind="maximize" Width="12" Height="12" Thickness="1.4"
                            IconBrush="{DynamicResource TextMutedBrush}" />
        </Button>
        <Button Grid.Column="12" Classes="nav caption closecaption" Width="40" Height="36" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="OnCloseWindowClick" ToolTip.Tip="关闭">
          <views:VectorIcon Kind="close" Width="13" Height="13" Thickness="1.5"
                            IconBrush="{DynamicResource TextMutedBrush}" />
        </Button>
      </Grid>
    </Border>

    <!-- ===== 行 1：TabX 书签栏（快捷访问固定项） ===== -->
    <Border Grid.Row="1" Background="{DynamicResource BookmarkBarBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1"
            IsVisible="{Binding IsExplorerMode}">
      <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,2">
        <views:VectorIcon Kind="bookmark" Width="18" Height="18" Thickness="1.6"
                          IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
        <TextBlock Text=" 可拖动常用文件/文档/文件夹到此，创建成书签，以便能快速找到并打开"
                         FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                         IsVisible="{Binding HasNoBookmarks}" />
        <ItemsControl ItemsSource="{Binding QuickAccessItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Panel Margin="0,0,2,0">
                <Button Classes="nav" Click="OnBookmarkItemClick">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="粘贴到该文件夹" Click="OnBookmarkMenuPasteClick" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <views:FileTypeIcon Width="14" Height="14" Category="{Binding IconCategory}"
                                       AccentColor="{Binding IconColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Button>
                <Button Classes="nav" Width="16" Height="16" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip.Tip="取消固定" Click="OnBookmarkUnpinClick">
                  <views:VectorIcon Kind="close" Width="9" Height="9" Thickness="1.4"
                                    IconBrush="{DynamicResource TextMutedBrush}" />
                </Button>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ===== 行 2：工具栏（TabX 同款：图标 + 文字） ===== -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2" Margin="6,2,6,2"
                IsVisible="{Binding IsExplorerMode}">
      <Button Classes="nav tool" Click="OnToggleIdeModeClick" ToolTip.Tip="切换到 IDE 模式">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="code" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="IDE 模式" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" ToolTip.Tip="切换视图">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="view" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="查看" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="超大图标" Tag="ExtraLargeIcons" Click="OnViewModeClick" />
            <MenuItem Header="大图标" Tag="LargeIcons" Click="OnViewModeClick" />
            <MenuItem Header="中图标" Tag="MediumIcons" Click="OnViewModeClick" />
            <MenuItem Header="小图标" Tag="SmallIcons" Click="OnViewModeClick" />
            <MenuItem Header="列表" Tag="List" Click="OnViewModeClick" />
            <MenuItem Header="详细信息" Tag="Details" Click="OnViewModeClick" />
            <MenuItem Header="平铺" Tag="Tile" Click="OnViewModeClick" />
            <MenuItem Header="内容" Tag="Content" Click="OnViewModeClick" />
            <Separator />
            <MenuItem Header="文件夹选项" Click="OnFolderOptionsClick" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button Classes="nav tool" ToolTip.Tip="复制（含路径与名称变体）">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="copy" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="复制" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="复制" Tag="files" Click="OnCopyVariantClick" />
            <MenuItem Header="复制文件所在路径" Tag="dir" Click="OnCopyVariantClick" />
            <MenuItem Header="复制文件完整路径" Tag="full" Click="OnCopyVariantClick" />
            <MenuItem Header="复制文件名称" Tag="name" Click="OnCopyVariantClick" />
            <MenuItem Header="复制文件名称（带扩展名）" Tag="nameext" Click="OnCopyVariantClick" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarCutClick" ToolTip.Tip="剪切勾选项">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="cut" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="剪切" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarPasteClick" ToolTip.Tip="粘贴到当前目录（剪贴板无文件时不可用）"
              IsEnabled="{Binding CanPasteFromClipboard}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="paste" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="粘贴" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarNewFolderClick" ToolTip.Tip="新建文件夹">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="newfolder" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="新建文件夹" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarBatchRenameClick" ToolTip.Tip="批量改名（先勾选条目）">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="rename" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="批量改名" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarEncodeConvertClick" ToolTip.Tip="编码转换（先勾选条目，转换文件名编码）">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="encode" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="编码转换" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarDeleteClick" ToolTip.Tip="删除勾选项（Windows 移入回收站）">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="delete" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="回收站" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarHiddenClick" ToolTip.Tip="显示 / 隐藏隐藏条目">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="eye" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="显示隐藏条目" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarInfoPaneClick" ToolTip.Tip="显示 / 隐藏详细信息窗格">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="info" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="显示详细信息窗格" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnToolbarRefreshClick" ToolTip.Tip="刷新 (F5)">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <views:VectorIcon Kind="refresh" Width="14" Height="14" Thickness="1.6"
                            IconBrush="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="刷新" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarTextBrush}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- ===== 行 3：导航 + 可编辑地址栏（点击空白即编辑）+ 最近 / 刷新 / 收藏 + 搜索 ===== -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,240" Margin="6,2,6,4" IsVisible="{Binding IsExplorerMode}">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
        <Button Classes="nav tool" Click="OnBackClick" ToolTip.Tip="后退">
          <views:VectorIcon Kind="back" Width="14" Height="14" Thickness="1.6" IconBrush="{DynamicResource TextMutedBrush}" />
        </Button>
        <Button Classes="nav tool" Click="OnForwardClick" ToolTip.Tip="前进">
          <views:VectorIcon Kind="forward" Width="14" Height="14" Thickness="1.6" IconBrush="{DynamicResource TextMutedBrush}" />
        </Button>
        <Button Classes="nav tool" Click="OnUpClick" ToolTip.Tip="上一级">
          <views:VectorIcon Kind="up" Width="14" Height="14" Thickness="1.6" IconBrush="{DynamicResource TextMutedBrush}" />
        </Button>
      </StackPanel>
      <Border Grid.Column="1" x:Name="AddressBarBorder" Margin="6,0,0,0" Background="{DynamicResource ChromeBrush}" CornerRadius="3" MinHeight="30"
              BorderBrush="{DynamicResource AddressBarBorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <Panel Grid.Column="0">
            <!-- 点击路径区空白处即进入编辑，无需专门按钮 -->
            <Button x:Name="AddressEditArea" Classes="nav" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Click="OnBreadcrumbEditClick" ToolTip.Tip="点击编辑路径" />
            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="1" Margin="4,2" VerticalAlignment="Center" />
            <TextBox x:Name="AddressBox" IsVisible="False" PlaceholderText="输入路径后按回车跳转" KeyDown="OnAddressKeyDown" LostFocus="OnAddressBoxLostFocus" />
          </Panel>
          <Button Grid.Column="1" x:Name="RecentButton" Classes="nav" Width="30"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Click="OnRecentClick" ToolTip.Tip="最近访问">
            <views:VectorIcon Kind="clock" Width="14" Height="14" Thickness="1.6" IconBrush="{DynamicResource TextMutedBrush}" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ListBox x:Name="RecentList" ItemsSource="{Binding RecentPaths}" MaxHeight="320" MinWidth="380"
                         Background="Transparent" BorderThickness="0" SelectionChanged="OnRecentSelected">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="2,3" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="2" Classes="nav" Width="30"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Click="OnAddressRefreshClick" ToolTip.Tip="刷新 (F5)">
            <views:VectorIcon Kind="refresh" Width="14" Height="14" Thickness="1.6" IconBrush="{DynamicResource TextMutedBrush}" />
          </Button>
          <Button Grid.Column="3" Classes="nav" Width="30"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Click="OnPinClick" ToolTip.Tip="收藏当前文件夹到书签">
            <views:VectorIcon Kind="bookmark" Width="14" Height="14" Thickness="1.6" IconBrush="{DynamicResource TextMutedBrush}" />
          </Button>
        </Grid>
      </Border>
      <TextBox Grid.Column="2" x:Name="SearchBox" Width="200" PlaceholderText="搜索当前目录" TextChanged="OnSearchTextChanged" />
    </Grid>

    <!-- ===== 行 4：左侧导航栏 + 内容区（资源管理器模式）/ IDE 工作区（IDE 模式） ===== -->
    <Panel Grid.Row="4">
    <Grid ColumnDefinitions="200,*" IsVisible="{Binding IsExplorerMode}">
      <Border Grid.Column="0" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="4">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
              <views:VectorIcon Kind="bookmark" Width="14" Height="14" Thickness="1.6"
                                IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
              <TextBlock Text="快捷访问" FontWeight="Medium" Foreground="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <ListBox x:Name="PinnedNavList" Classes="navlist" ItemsSource="{Binding QuickAccessItems}" SelectionMode="Single"
                     Background="Transparent" BorderThickness="0" SelectionChanged="OnNavSelectionChanged"
                     PointerReleased="OnNavPointerReleased">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,0">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="粘贴到该文件夹" Click="OnNavMenuPasteClick" />
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <views:FileTypeIcon Width="15" Height="15" Category="{Binding IconCategory}"
                                       AccentColor="{Binding IconColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 此电脑分组标题：点击即可导航到此电脑根视图 -->
            <Button Classes="nav" HorizontalAlignment="Stretch" Margin="4,14,4,2" Click="OnThisPcHeaderClick" ToolTip.Tip="导航到此电脑">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <views:VectorIcon Kind="monitor" Width="14" Height="14" Thickness="1.6"
                                  IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
                <TextBlock Text="此电脑" FontWeight="Medium" Foreground="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <ListBox x:Name="PcNavList" Classes="navlist" ItemsSource="{Binding ThisPcItems}" SelectionMode="Single"
                     Background="Transparent" BorderThickness="0" SelectionChanged="OnNavSelectionChanged"
                     PointerReleased="OnNavPointerReleased">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,0">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="粘贴到该文件夹" Click="OnNavMenuPasteClick" />
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <views:FileTypeIcon Width="15" Height="15" Category="{Binding IconCategory}"
                                       AccentColor="{Binding IconColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,14,4,2">
              <views:VectorIcon Kind="globe" Width="14" Height="14" Thickness="1.6"
                                IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
              <TextBlock Text="网络" FontWeight="Medium" Foreground="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnConnectionsClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <views:VectorIcon Kind="globe" Width="15" Height="15" Thickness="1.6"
                                  IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
                <TextBlock Text="连接管理" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>

            <!-- 全局搜索（Everything IPC 内核加速） -->
            <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnGlobalSearchClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <views:VectorIcon Kind="search" Width="15" Height="15" Thickness="1.6"
                                  IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
                <TextBlock Text="全局搜索" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>

            <!-- 目录 / 文件比对（WinMerge 逆向成果合并：目录双栏状态 + 文件按行对齐） -->
            <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnCompareClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <views:VectorIcon Kind="compare" Width="15" Height="15" Thickness="1.6"
                                  IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
                <TextBlock Text="文件比对" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>

            <!-- 磁盘视图（WizTree 逆向成果合并：目录占用统计） -->
            <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnDiskViewClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <views:VectorIcon Kind="donut" Width="15" Height="15" Thickness="1.6"
                                  IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
                <TextBlock Text="磁盘视图" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>

            <!-- 进程监控（跨平台任务管理器：资源摘要 + 进程列表） -->
            <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnProcessMonitorClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <views:VectorIcon Kind="activity" Width="15" Height="15" Thickness="1.6"
                                  IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
                <TextBlock Text="进程监控" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>

            <!-- 启动项管理（系统开机自启程序与服务 + 自定义启动项） -->
            <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnStartupManagerClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <views:VectorIcon Kind="power" Width="15" Height="15" Thickness="1.6"
                                  IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
                <TextBlock Text="启动项管理" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>

            <!-- 右键管理（系统右键菜单项启停，与设置窗口「右键菜单」分页共用同一管理界面） -->
            <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnRightMenuManagerClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <views:VectorIcon Kind="sliders" Width="15" Height="15" Thickness="1.6"
                                  IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
                <TextBlock Text="右键管理" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>

            <!-- 截图与录屏（Screenpresso 逆向成果合并：截图 / 录屏 / 全局快捷键 / 产物历史） -->
            <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnCaptureClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <views:VectorIcon Kind="camera" Width="15" Height="15" Thickness="1.6"
                                  IconBrush="{DynamicResource AccentGlyphBrush}" VerticalAlignment="Center" />
                <TextBlock Text="截图与录屏" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- 内容区：随选中标签切换面板 -->
      <ContentControl Grid.Column="1" Content="{Binding SelectedTab}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:FileTabViewModel">
            <views:FileListPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:TaskBoardViewModel">
            <views:TaskBoardPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:ConnectionManagerViewModel">
            <views:ConnectionPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:TerminalTabViewModel">
            <views:TerminalPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:RemoteTransferPanelViewModel">
            <views:RemoteTransferPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:EditorTabViewModel">
            <views:EditorPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:MediaTabViewModel">
            <views:MediaPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:SearchTabViewModel">
            <views:SearchPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:DiskViewPanelViewModel">
            <views:DiskViewPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:ProcessPanelViewModel">
            <views:ProcessPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:CaptureTabViewModel">
            <views:CapturePanel />
          </DataTemplate>
          <DataTemplate DataType="vm:CompareTabViewModel">
            <views:ComparePanel />
          </DataTemplate>
          <DataTemplate DataType="vm:StartupManagerViewModel">
            <views:StartupPanel />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>

    <!-- IDE 模式工作区：资源树 + 编辑器标签 + 代码区 + 底部面板 -->
    <Panel IsVisible="{Binding IsIdeMode}">
      <views:IdeShellView DataContext="{Binding IdeShell}" />
    </Panel>
    </Panel>

    <!-- ===== 行 5：状态栏（N 个项目 + 网页端服务地址；IDE 模式由 IDE 状态栏接管） ===== -->
    <Border Grid.Row="5" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0"
            IsVisible="{Binding IsExplorerMode}">
      <Grid ColumnDefinitions="*,Auto" Margin="12,4,8,4">
        <TextBlock Grid.Column="0" x:Name="StatusCountText" Text="0 个项目" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Grid.Column="1" Text="{Binding WebServiceStatus}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.7" />
      </Grid>
    </Border>
  </Grid>
</Window>
