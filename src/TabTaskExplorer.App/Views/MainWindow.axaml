<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TabTaskExplorer.App.Views"
        xmlns:vm="using:TabTaskExplorer.App.ViewModels"
        x:Class="TabTaskExplorer.App.Views.MainWindow"
        Title="TabTaskExplorer"
        Width="1200" Height="760"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="34"
        KeyDown="OnWindowKeyDown">

  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe Fluent Icons</FontFamily>
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- ===== 行 0：自绘标题栏 + 标签条 + 窗口控制按钮 ===== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Background="#1E1E1E"
          PointerPressed="OnCaptionPointerPressed" DoubleTapped="OnCaptionDoubleTapped">
      <ListBox Grid.Column="0" x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
               SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="6,4,0,0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
          </ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0,4,0" DoubleTapped="OnTabHeaderDoubleTapped">
              <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
              <Button Grid.Column="2" Content="×" Width="18" Height="18" Padding="0" Background="Transparent" Click="OnCloseTabClick" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Grid.Column="1" Classes="nav" FontFamily="{StaticResource IconFont}" Content="&#xE710;" Width="34" Height="30" VerticalAlignment="Top" Click="OnNewTabClick" ToolTip.Tip="新建文件标签 (Ctrl+T)" />
      <Button Grid.Column="2" Classes="caption" FontFamily="{StaticResource IconFont}" Content="&#xE921;" Width="44" Height="32" Click="OnMinimizeClick" />
      <Button Grid.Column="3" Classes="caption" FontFamily="{StaticResource IconFont}" Content="&#xE922;" Width="44" Height="32" Click="OnMaximizeClick" />
      <Button Grid.Column="4" Classes="caption close" FontFamily="{StaticResource IconFont}" Content="&#xE8BB;" Width="44" Height="32" Click="OnCloseWindowClick" />
    </Grid>

    <!-- ===== 行 1：工具栏 ===== -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Margin="6,2,6,2"
                IsVisible="{Binding DataContext.ShowToolbar, RelativeSource={RelativeSource AncestorType=Window}}">
      <Button Classes="nav tool" Click="OnViewModeClick" ToolTip.Tip="切换视图：详细信息 / 大图标 / 中图标">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B3;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="视图" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnBatchRenameClick" ToolTip.Tip="批量改名（先勾选条目）">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8AC;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="批量改名" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnNewFolderClick" ToolTip.Tip="新建文件夹">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F4;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="新建文件夹" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnSelectAllClick" ToolTip.Tip="全选当前目录">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73A;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="全选" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnDeleteClick" ToolTip.Tip="删除勾选项 (Delete)">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="删除" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnRefreshClick" ToolTip.Tip="刷新 (F5)">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="刷新" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnCloseAllTabsClick" ToolTip.Tip="关闭所有标签页">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="关闭所有标签" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="nav tool" Click="OnInfoPaneClick" ToolTip.Tip="显示 / 隐藏信息窗格">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C9;" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="显示详细信息窗格" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- ===== 行 2：导航 + 地址栏 + 搜索 ===== -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,240" Margin="6,2,6,4">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
        <Button Classes="nav tool" FontFamily="{StaticResource IconFont}" Content="&#xE72B;" Click="OnBackClick" ToolTip.Tip="后退" />
        <Button Classes="nav tool" FontFamily="{StaticResource IconFont}" Content="&#xE72A;" Click="OnForwardClick" ToolTip.Tip="前进" />
        <Button Classes="nav tool" FontFamily="{StaticResource IconFont}" Content="&#xE74A;" Click="OnUpClick" ToolTip.Tip="上一级" />
      </StackPanel>
      <TextBox Grid.Column="1" x:Name="AddressBox" PlaceholderText="输入路径后按回车跳转" Margin="6,0,0,0" KeyDown="OnAddressKeyDown" />
      <TextBox Grid.Column="2" x:Name="SearchBox" PlaceholderText="搜索当前目录" Margin="8,0,0,0" TextChanged="OnSearchTextChanged" />
    </Grid>

    <!-- ===== 行 3：侧边栏 + 内容 ===== -->
    <Grid Grid.Row="3" ColumnDefinitions="220,*">

      <Border Grid.Column="0" BorderBrush="#40808080" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="4">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE735;" Foreground="#4CC2FF" VerticalAlignment="Center" />
              <TextBlock Text="快捷访问" FontWeight="Medium" Foreground="#4CC2FF" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding QuickAccessItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0" Classes="nav" HorizontalAlignment="Stretch" Click="OnSidebarItemClick">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding IconGlyph}" Foreground="#4CC2FF" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="nav" FontFamily="{StaticResource IconFont}" Content="&#xE718;" Width="22" FontSize="10" ToolTip.Tip="取消固定" Click="OnUnpinClick" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,14,4,2">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F8;" Foreground="#4CC2FF" VerticalAlignment="Center" />
              <TextBlock Text="此电脑" FontWeight="Medium" Foreground="#4CC2FF" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ThisPcItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnSidebarItemClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding IconGlyph}" Foreground="#4CC2FF" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,14,4,2">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE968;" Foreground="#4CC2FF" VerticalAlignment="Center" />
              <TextBlock Text="网络" FontWeight="Medium" Foreground="#4CC2FF" VerticalAlignment="Center" />
            </StackPanel>
            <Button Classes="nav" HorizontalAlignment="Stretch" Click="OnNetworkClick">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE968;" Foreground="#4CC2FF" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="网络位置（即将支持）" VerticalAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- 内容区：随选中标签切换面板 -->
      <ContentControl Grid.Column="1" Content="{Binding SelectedTab}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:FileTabViewModel">
            <views:FileListPanel />
          </DataTemplate>
          <DataTemplate DataType="vm:TaskBoardViewModel">
            <views:TaskBoardPanel />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>

    <!-- ===== 行 4：状态栏 ===== -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="12,5,8,5">
      <TextBlock Grid.Column="0" Text="就绪" FontSize="12" Opacity="0.7" />
      <Button Grid.Column="1" Classes="nav" FontFamily="{StaticResource IconFont}" Content="&#xE713;" FontSize="12" Click="OnSettingsClick" ToolTip.Tip="设置" />
    </Grid>
  </Grid>
</Window>
