<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TabTaskExplorer.App.Views.EditorPanel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="8">

    <!-- 工具栏 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button x:Name="SaveButton" Content="保存 (Ctrl+S)" Click="OnSaveClick" />
      <TextBlock Text="{Binding RemotePath}" VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
    </StackPanel>

    <!-- 编辑区 -->
    <Border Grid.Row="1" Padding="8" BorderBrush="#40808080" BorderThickness="1" CornerRadius="8">
      <TextBox x:Name="EditorBox"
               Text="{Binding Text}"
               AcceptsReturn="True"
               FontFamily="Consolas,monospace"
               FontSize="13"
               TextWrapping="NoWrap"
               Background="Transparent"
               BorderThickness="0"
               KeyDown="OnEditorKeyDown" />
    </Border>

    <!-- 状态行 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <TextBlock Text="未保存更改将以 * 标示；保存直接写回远端。" FontSize="11" Opacity="0.55" />
      <TextBlock x:Name="StatusBlock" Text="{Binding StatusText}" FontSize="11" Opacity="0.85" />
    </StackPanel>

  </Grid>
</UserControl>
