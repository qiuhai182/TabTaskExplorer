<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TabTaskExplorer.App.Views.BarcodeResultWindow"
        Title="二维码 / 条码识别结果" Width="620" Height="360" MinWidth="420" MinHeight="240"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="14">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="识别结果" FontWeight="Medium" FontSize="16" />
      <TextBlock x:Name="FormatText" FontSize="12" Opacity="0.7" />
    </StackPanel>
    <TextBox Grid.Row="1" x:Name="ResultBox" AcceptsReturn="True" TextWrapping="Wrap"
             IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="复制内容" Click="OnCopyClick" />
      <Button Content="关闭" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
