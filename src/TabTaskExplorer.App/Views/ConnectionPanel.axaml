<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TabTaskExplorer.App.Views.ConnectionPanel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="8">

    <!-- 工具栏 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button x:Name="NewButton" Content="新建连接" Click="OnNewClick" />
      <Button x:Name="DeleteButton" Content="删除" Click="OnDeleteClick" />
      <Button x:Name="TestButton" Content="测试连接" Click="OnTestClick" />
      <Button x:Name="ExportButton" Content="导出" Click="OnExportClick" ToolTip.Tip="导出全部连接配置到 JSON 文件" />
      <Button x:Name="ImportButton" Content="导入" Click="OnImportClick" ToolTip.Tip="从 JSON 文件导入连接配置" />
    </StackPanel>

    <!-- 列表 + 编辑表单 -->
    <Grid Grid.Row="1" ColumnDefinitions="280,8,*">

      <Border Grid.Column="0" Padding="6" BorderBrush="#40808080" BorderThickness="1" CornerRadius="8">
        <ListBox x:Name="ConnectionList" ItemsSource="{Binding Connections}"
                 SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                 SelectionChanged="OnSelectedChanged" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,2">
                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                <TextBlock FontSize="11" Opacity="0.7" Text="{Binding Summary}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2" Padding="12" BorderBrush="#40808080" BorderThickness="1" CornerRadius="8">
        <StackPanel x:Name="EditForm" IsEnabled="False" MaxWidth="460" HorizontalAlignment="Left">
          <TextBlock Text="连接信息" FontWeight="Medium" Margin="0,0,0,8" />

          <TextBlock Text="名称" FontSize="12" />
          <TextBox x:Name="NameBox" Margin="0,2,0,8" />

          <TextBlock Text="协议" FontSize="12" />
          <ComboBox x:Name="ProtocolBox" Margin="0,2,0,8" MinWidth="160" SelectionChanged="OnProtocolChanged">
            <ComboBoxItem Content="SSH" />
            <ComboBoxItem Content="FTP" />
          </ComboBox>

          <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,8">
            <StackPanel Grid.Column="0">
              <TextBlock Text="主机" FontSize="12" />
              <TextBox x:Name="HostBox" Margin="0,2,0,0" PlaceholderText="例如 192.168.1.10" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="端口（留空用默认）" FontSize="12" />
              <TextBox x:Name="PortBox" Margin="0,2,0,0" PlaceholderText="22" />
            </StackPanel>
          </Grid>

          <TextBlock Text="用户名" FontSize="12" />
          <TextBox x:Name="UserBox" Margin="0,2,0,8" />

          <TextBlock Text="认证方式" FontSize="12" />
          <ComboBox x:Name="AuthBox" Margin="0,2,0,8" MinWidth="160" SelectionChanged="OnAuthChanged">
            <ComboBoxItem Content="密码" />
            <ComboBoxItem Content="私钥文件" />
          </ComboBox>

          <StackPanel x:Name="SecretSection" IsVisible="False">
            <TextBlock Text="密码（留空保持原密码）" FontSize="12" />
            <TextBox x:Name="SecretBox" Margin="0,2,0,8" PasswordChar="•" />
          </StackPanel>

          <StackPanel x:Name="KeySection" IsVisible="False">
            <TextBlock Text="私钥文件路径" FontSize="12" />
            <TextBox x:Name="KeyPathBox" Margin="0,2,0,8" PlaceholderText="例如 C:\Users\you\.ssh\id_rsa" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button x:Name="SaveButton" Content="保存" Click="OnSaveClick" />
            <Button x:Name="CancelButton" Content="取消编辑" Click="OnCancelClick" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 状态与测试结果 -->
    <TextBlock Grid.Row="2" x:Name="StatusText" Margin="2,8,2,0" TextWrapping="Wrap" Opacity="0.85" />
  </Grid>
</UserControl>
