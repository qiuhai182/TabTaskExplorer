<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:capture="using:TabTaskExplorer.App.Services.Capture"
        x:Class="TabTaskExplorer.App.Views.ScreenColorPickerWindow"
        Title="屏幕取色" WindowDecorations="None" CanResize="False" WindowStartupLocation="Manual"
        Topmost="True" ShowInTaskbar="False" Background="Black"
        KeyDown="OnWindowKeyDown"
        PointerPressed="OnWindowPointerPressed"
        PointerMoved="OnWindowPointerMoved">
  <Canvas x:Name="RootCanvas" ClipToBounds="True">
    <Image x:Name="ScreenImage" Stretch="Fill" Canvas.Left="0" Canvas.Top="0" />
    <Border x:Name="InfoPanel" Background="#E61E1E1E" CornerRadius="6" Padding="10" IsVisible="False">
      <StackPanel Spacing="8">
        <Border Width="120" Height="120" Background="#FF111114" CornerRadius="3">
          <capture:ColorMagnifierControl x:Name="Magnifier" />
        </Border>
        <TextBlock x:Name="HexText" Text="#000000" Foreground="White" FontFamily="Consolas" FontSize="18" />
        <TextBlock x:Name="RgbText" Text="RGB 0, 0, 0" Foreground="White" FontSize="12" Opacity="0.85" />
        <Border x:Name="Swatch" Width="120" Height="22" CornerRadius="3" Background="Black" />
        <TextBlock Text="单击复制颜色，Esc 或右键取消" Foreground="White" FontSize="11" Opacity="0.7" />
      </StackPanel>
    </Border>
    <Border x:Name="HintPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"
            Background="#E61E1E1E" CornerRadius="6" Padding="14,8">
      <TextBlock Text="屏幕取色：移动鼠标查看颜色，单击复制十六进制颜色，Esc 或右键取消"
                 Foreground="White" FontSize="13" />
    </Border>
  </Canvas>
</Window>
