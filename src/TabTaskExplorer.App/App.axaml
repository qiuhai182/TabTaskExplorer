<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="using:FluentAvalonia.Styling"
             x:Class="TabTaskExplorer.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <styling:FluentAvaloniaTheme />

    <!-- ======== TabX Explorer 风格：悬停浅亮、选中深亮 ======== -->
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="#2A2D2E"/>
    </Style>
    <Style Selector="Border.row.checked">
      <Setter Property="Background" Value="#37373D"/>
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="Background" Value="#2A2D2E"/>
    </Style>
    <Style Selector="Border.tile.checked">
      <Setter Property="Background" Value="#37373D"/>
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A2D2E"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#37373D"/>
    </Style>

    <Style Selector="ListBoxItem.tabhover">
      <Setter Property="Background" Value="#2A2D2E"/>
    </Style>
    <Style Selector="ListBoxItem.tabactive">
      <Setter Property="Background" Value="#37373D"/>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A2D2E"/>
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#37373D"/>
    </Style>

    <!-- 托盘图标在 App.axaml.cs 中以代码注册（关闭主窗口后常驻守护） -->
  </Application.Styles>

</Application>
