<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="using:FluentAvalonia.Styling"
             x:Class="TabTaskExplorer.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>

      <!-- ======== 主题字典：Dark 默认（TabX 官方深色配色），Light 可切换 ======== -->
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ChromeBrush" Color="#212121"/>
          <SolidColorBrush x:Key="ContentBrush" Color="#191919"/>
          <SolidColorBrush x:Key="SeparatorBrush" Color="#515151"/>
          <SolidColorBrush x:Key="SubtleBorderBrush" Color="#323232"/>
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8E8E8"/>
          <SolidColorBrush x:Key="TextMutedBrush" Color="#808080"/>
          <SolidColorBrush x:Key="AccentGlyphBrush" Color="#4CC2FF"/>
          <SolidColorBrush x:Key="RowHoverBrush" Color="#2E2E2E"/>
          <SolidColorBrush x:Key="RowSelectedBrush" Color="#37373D"/>
          <SolidColorBrush x:Key="TabHoverBrush" Color="#2E2E2E"/>
          <SolidColorBrush x:Key="TabActiveBrush" Color="#191919"/>
          <SolidColorBrush x:Key="BookmarkBarBrush" Color="#3B3B3B"/>
          <SolidColorBrush x:Key="AddressBarBorderBrush" Color="#525252"/>
          <SolidColorBrush x:Key="ToolbarTextBrush" Color="#FFFFFF"/>

          <CroppedBitmap x:Key="BtnMinN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_min.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnMinH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_min.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnMinP" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_min.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnMaxN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_max.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnMaxH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_max.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnMaxP" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_max.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnRestoreN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_restore.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnRestoreH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_restore.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnRestoreP" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_restore.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnCloseN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_close.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnCloseH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_close.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnCloseP" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_close.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnSettingN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_setting.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnSettingH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_setting.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnSettingP" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_setting.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnRecoveryN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_recovery.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnRecoveryH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_recovery.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnRecoveryP" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_recovery.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnDefaultN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_default.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnDefaultH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_default.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnDefaultP" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_default.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnToolboxN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_toolbox.png" SourceRect="0,0,16,16"/>
          <CroppedBitmap x:Key="BtnToolboxH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_toolbox.png" SourceRect="16,0,16,16"/>
          <CroppedBitmap x:Key="BtnToolboxP" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_toolbox.png" SourceRect="32,0,16,16"/>
          <CroppedBitmap x:Key="BtnTabAddN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_tab_add.png" SourceRect="0,0,24,24"/>
          <CroppedBitmap x:Key="BtnTabAddH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_tab_add.png" SourceRect="24,0,24,24"/>
          <CroppedBitmap x:Key="TabCloseN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_tab_close.png" SourceRect="0,0,16,16"/>
          <CroppedBitmap x:Key="TabCloseH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_tab_close.png" SourceRect="16,0,16,16"/>
          <CroppedBitmap x:Key="TabCloseP" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_tab_close.png" SourceRect="32,0,16,16"/>
          <CroppedBitmap x:Key="BtnThemeN" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_Switch_Theme.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnThemeH" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_Switch_Theme.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnThemeP" Source="avares://TabTaskExplorer/Assets/TabX-Dark/btn_Switch_Theme.png" SourceRect="80,0,40,34"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ChromeBrush" Color="#F1F1F1"/>
          <SolidColorBrush x:Key="ContentBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SeparatorBrush" Color="#EBEBEC"/>
          <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E9E9E9"/>
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1C1C"/>
          <SolidColorBrush x:Key="TextMutedBrush" Color="#808080"/>
          <SolidColorBrush x:Key="AccentGlyphBrush" Color="#4A8FD0"/>
          <SolidColorBrush x:Key="RowHoverBrush" Color="#F5F7FA"/>
          <SolidColorBrush x:Key="RowSelectedBrush" Color="#DCE9F5"/>
          <SolidColorBrush x:Key="TabHoverBrush" Color="#E4E4E4"/>
          <SolidColorBrush x:Key="TabActiveBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BookmarkBarBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AddressBarBorderBrush" Color="#DCDDDE"/>
          <SolidColorBrush x:Key="ToolbarTextBrush" Color="#808080"/>

          <CroppedBitmap x:Key="BtnMinN" Source="avares://TabTaskExplorer/Assets/TabX/btn_min.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnMinH" Source="avares://TabTaskExplorer/Assets/TabX/btn_min.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnMinP" Source="avares://TabTaskExplorer/Assets/TabX/btn_min.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnMaxN" Source="avares://TabTaskExplorer/Assets/TabX/btn_max.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnMaxH" Source="avares://TabTaskExplorer/Assets/TabX/btn_max.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnMaxP" Source="avares://TabTaskExplorer/Assets/TabX/btn_max.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnRestoreN" Source="avares://TabTaskExplorer/Assets/TabX/btn_restore.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnRestoreH" Source="avares://TabTaskExplorer/Assets/TabX/btn_restore.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnRestoreP" Source="avares://TabTaskExplorer/Assets/TabX/btn_restore.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnCloseN" Source="avares://TabTaskExplorer/Assets/TabX/btn_close.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnCloseH" Source="avares://TabTaskExplorer/Assets/TabX/btn_close.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnCloseP" Source="avares://TabTaskExplorer/Assets/TabX/btn_close.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnSettingN" Source="avares://TabTaskExplorer/Assets/TabX/btn_setting.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnSettingH" Source="avares://TabTaskExplorer/Assets/TabX/btn_setting.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnSettingP" Source="avares://TabTaskExplorer/Assets/TabX/btn_setting.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnRecoveryN" Source="avares://TabTaskExplorer/Assets/TabX/btn_recovery.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnRecoveryH" Source="avares://TabTaskExplorer/Assets/TabX/btn_recovery.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnRecoveryP" Source="avares://TabTaskExplorer/Assets/TabX/btn_recovery.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnDefaultN" Source="avares://TabTaskExplorer/Assets/TabX/btn_default.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnDefaultH" Source="avares://TabTaskExplorer/Assets/TabX/btn_default.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnDefaultP" Source="avares://TabTaskExplorer/Assets/TabX/btn_default.png" SourceRect="80,0,40,34"/>
          <CroppedBitmap x:Key="BtnToolboxN" Source="avares://TabTaskExplorer/Assets/TabX/btn_toolbox.png" SourceRect="0,0,16,16"/>
          <CroppedBitmap x:Key="BtnToolboxH" Source="avares://TabTaskExplorer/Assets/TabX/btn_toolbox.png" SourceRect="16,0,16,16"/>
          <CroppedBitmap x:Key="BtnToolboxP" Source="avares://TabTaskExplorer/Assets/TabX/btn_toolbox.png" SourceRect="32,0,16,16"/>
          <CroppedBitmap x:Key="BtnTabAddN" Source="avares://TabTaskExplorer/Assets/TabX/btn_tab_add.png" SourceRect="0,0,24,24"/>
          <CroppedBitmap x:Key="BtnTabAddH" Source="avares://TabTaskExplorer/Assets/TabX/btn_tab_add.png" SourceRect="24,0,24,24"/>
          <CroppedBitmap x:Key="TabCloseN" Source="avares://TabTaskExplorer/Assets/TabX/btn_tab_close.png" SourceRect="0,0,16,16"/>
          <CroppedBitmap x:Key="TabCloseH" Source="avares://TabTaskExplorer/Assets/TabX/btn_tab_close.png" SourceRect="16,0,16,16"/>
          <CroppedBitmap x:Key="TabCloseP" Source="avares://TabTaskExplorer/Assets/TabX/btn_tab_close.png" SourceRect="32,0,16,16"/>
          <CroppedBitmap x:Key="BtnThemeN" Source="avares://TabTaskExplorer/Assets/TabX/btn_Switch_Theme.png" SourceRect="0,0,40,34"/>
          <CroppedBitmap x:Key="BtnThemeH" Source="avares://TabTaskExplorer/Assets/TabX/btn_Switch_Theme.png" SourceRect="40,0,40,34"/>
          <CroppedBitmap x:Key="BtnThemeP" Source="avares://TabTaskExplorer/Assets/TabX/btn_Switch_Theme.png" SourceRect="80,0,40,34"/>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- FluentTheme 提供 ContextMenu 等基础控件模板（FluentAvalonia 主题不含 ContextMenu 模板，缺失时菜单无模板测量为 0×0 不可见）；
         放在 FluentAvaloniaTheme 之前，冲突时仍由后者覆盖 -->
    <FluentTheme />
    <styling:FluentAvaloniaTheme />

    <!-- ======== TabX 风格交互：悬停 / 选中随主题字典切换 ======== -->
    <!-- 行与磁贴的常驻透明底色必须写成基础样式并放在各动态样式之前：若直接写在元素上（本地值），会压过下面的悬停、选中与拖放高亮样式 -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
    </Style>
    <Style Selector="Border.row.checked">
      <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
    </Style>
    <Style Selector="Border.tile:checked">
      <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
    </Style>

    <!-- 拖放目标高亮：拖拽经过文件行 / 磁贴 / 左侧导航项 / 书签项 / 标签时显示强调色边框与底色 -->
    <Style Selector="Border.row.droptarget">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentGlyphBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Border.tile.droptarget">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentGlyphBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="ListBoxItem.droptarget /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentGlyphBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.nav.droptarget /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentGlyphBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
    </Style>
    <!-- 选中行左侧不显示主题自带的紫色竖条（SelectionIndicator），与网页端选中效果保持一致 -->
    <Style Selector="ListBoxItem:selected /template/ Rectangle#SelectionIndicator">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Rectangle#SelectionIndicator">
      <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- 标签条：悬停变灰，选中融入内容区（TabX 行为） -->
    <Style Selector="ListBoxItem.tabhover">
      <Setter Property="Background" Value="{DynamicResource TabHoverBrush}"/>
    </Style>
    <Style Selector="ListBoxItem.tabactive">
      <Setter Property="Background" Value="{DynamicResource TabActiveBrush}"/>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
    </Style>
    <!-- 侧边栏等导航按钮失去鼠标时不再保留底色：焦点态只保留系统焦点框，不额外绘制高亮底色 -->
    <Style Selector="Button.nav:focus:not(:pointerover) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ======== 导航列表与设置分页：只允许鼠标当前位置项高亮 ========
         选中项不再常驻底色（否则鼠标移到新项时会出现旧项与新项同时高亮），改用文字强调色标示当前位置 -->
    <Style Selector="ListBox.navlist ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.navlist ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentGlyphBrush}"/>
    </Style>
    <Style Selector="ListBox.navlist ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
    </Style>

    <!-- 菜单项：指针已离开的旧项不再保留选中底色；键盘焦点项仍保留高亮，保证键盘导航可见 -->
    <Style Selector="MenuItem:selected:not(:pointerover):not(:focus) /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- 托盘图标在 App.axaml.cs 中以代码注册（关闭主窗口后常驻守护） -->
  </Application.Styles>

</Application>
