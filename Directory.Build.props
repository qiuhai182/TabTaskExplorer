<Project>

  <!-- 全仓库统一的编译设置：所有工程共用同一目标框架，保证跨平台编译一致性 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- 任何构建方式（dotnet run / dotnet build / VS / build.bat）编译前，先把本工程源码归一化为 UTF-8 BOM，根治编辑器反复转码导致的编译期中文乱码 -->
  <Target Name="NormalizeSourceEncoding" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <!-- 单个文件被占用或不可读时只记录警告并跳过，最后汇总跳过数量，不影响编译；
         只有写入后检测到 U+FFFD 乱码（真正影响编译）才返回非 0 -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$utf8Bom = New-Object System.Text.UTF8Encoding($true); $utf8Strict = New-Object System.Text.UTF8Encoding($false, $true); $gbk = [System.Text.Encoding]::GetEncoding(936); $files = Get-ChildItem -Path '$(MSBuildProjectDirectory)' -Recurse -File -Include *.cs,*.xaml,*.axaml,*.csproj,*.props,*.json; $done = 0; $skippedCount = 0; $skippedText = ''; $brokenCount = 0; $brokenText = ''; foreach ($file in $files) { try { $bytes = [System.IO.File]::ReadAllBytes($file.FullName); if ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) { $text = $utf8Strict.GetString($bytes[3..($bytes.Length-1)]) } else { try { $text = $utf8Strict.GetString($bytes) } catch { $text = $gbk.GetString($bytes) } }; while ($text.Length -gt 0 -and $text[0] -eq [char]0xFEFF) { $text = $text.Substring(1) }; if ($text.StartsWith('?&lt;') -or $text.StartsWith('?using')) { $text = $text.Substring(1) }; [System.IO.File]::WriteAllText($file.FullName, $text, $utf8Bom); $done = $done + 1; try { if ([System.IO.File]::ReadAllText($file.FullName, $utf8Strict).Contains([string][char]0xFFFD)) { $brokenCount = $brokenCount + 1; $brokenText = $brokenText + 'ENCODING-BROKEN: ' + $file.FullName + [Environment]::NewLine } } catch { } } catch { $skippedCount = $skippedCount + 1; $skippedText = $skippedText + 'WARNING: 编码归一化已跳过被占用或不可读文件：' + $file.FullName + [Environment]::NewLine } }; if ($skippedCount -gt 0) { Write-Host $skippedText; Write-Host ('WARNING: 编码归一化跳过 ' + $skippedCount + ' 个文件（被占用或不可读），不影响编译') }; if ($brokenCount -gt 0) { Write-Host $brokenText; Write-Host ('源码编码损坏：' + $brokenCount + ' 个文件包含 U+FFFD，编译中止'); exit 1 }; Write-Host ('编码归一化完成：已处理 ' + $done + ' 个文件，跳过 ' + $skippedCount + ' 个'); exit 0&quot;" />
  </Target>

</Project>
